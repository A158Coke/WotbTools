<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runtimeContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/runtimeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/versionGateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/versionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_mandatory_title"
            android:textColor="#F0F6FC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/update_mandatory_message"
            android:textColor="#8B949E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/versionCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/update_current_version"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/versionLatest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/update_latest_version"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <Button
            android:id="@+id/versionPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/update_now" />

        <Button
            android:id="@+id/versionLaterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/update_later" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runtimeErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/runtimeErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/runtime_error_title"
            android:textColor="#F0F6FC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/runtimeErrorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/runtime_error_retry" />

        <Button
            android:id="@+id/runtimeErrorBrowserButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/runtime_error_open_browser" />

        <!-- 诊断行（引擎 / 设备 / crash 计数），可长按选中复制，便于用户反馈问题。 -->
        <TextView
            android:id="@+id/runtimeErrorDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#8B949E"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
