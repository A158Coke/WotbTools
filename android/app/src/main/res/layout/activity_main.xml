<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runtimeContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/runtimeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 冷启动 / 引擎恢复期间的首帧占位；由 StartupSurfaceState 在首个内容绘制后移除。 -->
    <LinearLayout
        android:id="@+id/startupSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:contentDescription="@string/startup_loading"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/startup_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="@string/app_name"
            android:textColor="#8B949E"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/versionGateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/versionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/update_mandatory_title"
                android:textColor="#F0F6FC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/versionMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/update_mandatory_message"
                android:textColor="#8B949E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/versionCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/update_current_version"
                android:textColor="#8B949E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/versionLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_latest_version"
                android:textColor="#8B949E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/versionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/update_download_hint"
                android:textColor="#F0F6FC"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/versionProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/update_progress"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/versionBytes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8B949E"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/versionPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/update_now" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/runtimeErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/runtimeErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/runtime_error_title"
            android:textColor="#F0F6FC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/runtimeErrorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/runtime_error_retry" />

        <Button
            android:id="@+id/runtimeErrorBrowserButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/runtime_error_open_browser" />

        <!-- 诊断行（引擎 / 设备 / crash 计数），可长按选中复制，便于用户反馈问题。 -->
        <TextView
            android:id="@+id/runtimeErrorDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#8B949E"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
