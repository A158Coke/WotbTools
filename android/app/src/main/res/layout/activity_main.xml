<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webViewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/networkGateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/networkGateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/network_gate_title"
            android:textColor="#F0F6FC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/networkGateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/network_gate_message"
            android:textColor="#8B949E"
            android:textSize="16sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/network_gate_retry" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/versionGateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/versionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_mandatory_title"
            android:textColor="#F0F6FC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/update_mandatory_message"
            android:textColor="#8B949E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/versionCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/update_current_version"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/versionLatest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/update_latest_version"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <Button
            android:id="@+id/versionPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/update_now" />

        <Button
            android:id="@+id/versionLaterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/update_later" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/webErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/webErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_error_title"
            android:textColor="#F0F6FC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/webErrorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/web_error_retry" />
    </LinearLayout>
</FrameLayout>
