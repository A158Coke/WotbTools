# Docker 构建上下文排除了 .git；CI 必须把冻结的 release SHA 显式注入镜像。
ARG BUILD_COMMIT=unknown

FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /build
COPY common/tankopedia-tier1.json common/tankopedia-tier1.json
COPY common/tankopedia-tier2.json common/tankopedia-tier2.json
COPY common/tankopedia-tier3.json common/tankopedia-tier3.json
COPY common/tankopedia-tier4.json common/tankopedia-tier4.json
COPY common/tankopedia-tier5.json common/tankopedia-tier5.json
COPY common/tankopedia-tier6.json common/tankopedia-tier6.json
COPY common/tankopedia-tier7.json common/tankopedia-tier7.json
COPY common/tankopedia-tier8.json common/tankopedia-tier8.json
COPY common/tankopedia-tier9.json common/tankopedia-tier9.json
COPY common/tankopedia-tier10.json common/tankopedia-tier10.json
COPY common/map_names.json common/map_names.json
COPY common/tank_tactical_profiles.json common/tank_tactical_profiles.json
COPY common/map-semantics common/map-semantics
COPY java/pom.xml java/settings-docker.xml java/
COPY java/wotb-core/pom.xml java/wotb-core/pom.xml
COPY java/wotb-ai/pom.xml java/wotb-ai/pom.xml
COPY java/wotb-web/pom.xml java/wotb-web/pom.xml
WORKDIR /build/java
RUN mvn -s settings-docker.xml -pl wotb-core,wotb-web -am -DskipTests dependency:go-offline -q || true
WORKDIR /build
COPY java/wotb-core/src java/wotb-core/src
COPY java/wotb-ai/src java/wotb-ai/src
COPY java/wotb-web/src java/wotb-web/src
WORKDIR /build/java
RUN mvn -s settings-docker.xml -pl wotb-core,wotb-web -am -DskipTests clean package -q

RUN java -Djarmode=tools -jar wotb-web/target/wotb-web.jar extract --layers --destination /extracted

FROM eclipse-temurin:25-jre
ARG BUILD_COMMIT
ENV BUILD_COMMIT=${BUILD_COMMIT}
WORKDIR /app
# tools extracts a thin JAR referencing external dependencies.
COPY --from=build /extracted/dependencies/ ./
COPY --from=build /extracted/spring-boot-loader/ ./
COPY --from=build /extracted/snapshot-dependencies/ ./
COPY --from=build /extracted/application/ ./
EXPOSE 8087
CMD ["java", "-jar", "/app/wotb-web.jar"]
