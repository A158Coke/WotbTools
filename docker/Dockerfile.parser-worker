# Docker 构建上下文排除了 .git；CI 必须把冻结的 release SHA 显式注入镜像。
ARG BUILD_COMMIT=unknown

FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /build
COPY common/tankopedia-tier7.json common/tankopedia-tier7.json
COPY common/tankopedia-tier8.json common/tankopedia-tier8.json
COPY common/tankopedia-tier9.json common/tankopedia-tier9.json
COPY common/tankopedia-tier10.json common/tankopedia-tier10.json
COPY common/map_names.json common/map_names.json
COPY common/tank_tactical_profiles.json common/tank_tactical_profiles.json
COPY common/map-semantics common/map-semantics
COPY java/pom.xml java/settings-docker.xml java/
COPY java/wotb-contracts/pom.xml java/wotb-contracts/pom.xml
COPY java/wotb-object-storage-minio/pom.xml java/wotb-object-storage-minio/pom.xml
COPY java/wotb-broker-rabbitmq/pom.xml java/wotb-broker-rabbitmq/pom.xml
COPY java/wotb-core/pom.xml java/wotb-core/pom.xml
COPY java/wotb-result/pom.xml java/wotb-result/pom.xml
COPY java/wotb-playback/pom.xml java/wotb-playback/pom.xml
COPY java/wotb-replay-coordinator/pom.xml java/wotb-replay-coordinator/pom.xml
COPY java/wotb-replay-processing/pom.xml java/wotb-replay-processing/pom.xml
COPY java/wotb-parser-worker/pom.xml java/wotb-parser-worker/pom.xml
COPY java/wotb-ai/pom.xml java/wotb-ai/pom.xml
COPY java/wotb-web/pom.xml java/wotb-web/pom.xml
WORKDIR /build/java
RUN mvn -s settings-docker.xml -pl wotb-parser-worker -am -DskipTests dependency:go-offline -q || true
WORKDIR /build
COPY java/wotb-contracts/src java/wotb-contracts/src
COPY java/wotb-object-storage-minio/src java/wotb-object-storage-minio/src
COPY java/wotb-broker-rabbitmq/src java/wotb-broker-rabbitmq/src
COPY java/wotb-core/src java/wotb-core/src
COPY java/wotb-result/src java/wotb-result/src
COPY java/wotb-playback/src java/wotb-playback/src
COPY java/wotb-replay-processing/src java/wotb-replay-processing/src
COPY java/wotb-parser-worker/src java/wotb-parser-worker/src
WORKDIR /build/java
RUN mvn -s settings-docker.xml -pl wotb-parser-worker -am -DskipTests clean package -q

FROM eclipse-temurin:25-jre
ARG BUILD_COMMIT
ENV BUILD_COMMIT=${BUILD_COMMIT}
COPY --from=build /build/java/wotb-parser-worker/target/wotb-parser-worker.jar /app/app.jar
# worker 无公网端口、无数据库凭据：只消费 wotb.parser 并读写 MinIO 的 temp/jobs/* 。
CMD ["java", "-jar", "/app/app.jar"]
