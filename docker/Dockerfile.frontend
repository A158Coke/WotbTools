FROM node:24-alpine AS build
# Build identity：CI 经 build-arg 注入 git commit（Docker 上下文无 .git 无法自行 rev-parse）。
ARG BUILD_COMMIT=unknown
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci
COPY frontend/ .
COPY common/map_names.json /common/map_names.json
# 隐藏 QA 页（?view=vehicle-models）动态 import Tankopedia 车辆库（仅 tier10）
COPY common/tankopedia-tier10.json /common/tankopedia-tier10.json
COPY common/assets /common/assets
# League Rating V5 canonical 文档：RatingDocsPage 构建期以 ?raw 读取（.dockerignore 显式放行）
COPY docs/WotBTools_League_Rating_V5.md /docs/WotBTools_League_Rating_V5.md
ENV BUILD_COMMIT=${BUILD_COMMIT}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/homepage/sponsor.html frontend/homepage/sponsor-config.js /usr/share/nginx/html/
# Sponsor is a standalone static page, so expose its copyright-safe artwork at a stable URL.
COPY frontend/src/assets/showcase/sponsor/sponsor-bg-v1.svg /usr/share/nginx/html/sponsor-bg.svg
COPY common/assets/icon.ico common/assets/icon.png common/assets/wotbtoolslogo.png /usr/share/nginx/html/
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
