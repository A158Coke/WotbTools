FROM node:24-alpine AS build
# Build identity：CI 经 build-arg 注入 git commit（Docker 上下文无 .git，不能自行 rev-parse）。
ARG BUILD_COMMIT=unknown
# 确定性构建时间（unix 秒，通常是 commit 时间）：Docker 上下文无 .git，不传则 version.json /
# __BUILD_TIME__ 回落 wall-clock，同一 commit 重跑会产出不同字节的 bundle。
ARG SOURCE_DATE_EPOCH=
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# Public static-asset origin (currently Tencent COS). This is a deployment value,
# not a storage contract: frontend consumers remain behind AssetProvider.
ARG ASSET_BASE_URL=
WORKDIR /app
# pnpm 版本由 package.json#packageManager 钉住、经 corepack 激活；pnpm 本体与其原生二进制从
# npmmirror 下载（npmmirror 保留 npm 签名，corepack / pnpm 照常校验）。依赖 registry 取自
# frontend/.npmrc；安装脚本白名单、strictDepBuilds、minimumReleaseAge 取自 pnpm-workspace.yaml，
# 缺了它 esbuild 会被当作未审查的安装脚本而让安装失败。
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com COREPACK_ENABLE_DOWNLOAD_PROMPT=0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY frontend/ .
COPY common/map_names.json /common/map_names.json
# Assault static geometry is resolved by mapCode from semantic JSON at build time.
COPY common/map-semantics /common/map-semantics
# Tankopedia 车辆库：本机回放计算（replay-local/compute/tankopedia.ts）按需 import tier1–10，
# 百场 / 隐藏 QA 页用 tier10。common/ 是唯一事实源，按仓库相对路径放到 /common；
# frontend/src/docker-build-context.contract.test.js 断言前端引用的每个仓库外构建输入都在这里 COPY。
COPY common/tankopedia-tier1.json common/tankopedia-tier2.json common/tankopedia-tier3.json common/tankopedia-tier4.json common/tankopedia-tier5.json common/tankopedia-tier6.json common/tankopedia-tier7.json common/tankopedia-tier8.json common/tankopedia-tier9.json common/tankopedia-tier10.json /common/
# 坦克百科搜索别名（人工维护的搜索 metadata，utils/tankopediaQuery.js 构建期 import）：
# 与车辆库同一机制按仓库相对路径放到 /common；空对象 `{}` 也必须在上下文里，否则 Vite 解析不到该 import。
COPY common/tank_aliases.json /common/tank_aliases.json
COPY common/assets /common/assets
# 坦克配置器（research/）：仅全局图标集；所有数据（目录/物品/技能/参数/逐车模块）由
# 资产包 research/** 提供。common/ 是图标唯一事实源，整目录按仓库相对路径放到 /common。
COPY common/research /common/research
# Agent WASM identity SSOT：Vite 构建期从这里取 ref/release 并注入 __AGENT_WASM_COMMIT__ /
# __AGENT_WASM_RELEASE__（`frontend/src/docker-build-context.contract.test.js` 断言这条 COPY）。
# 路径与仓库布局一致（/app = frontend/，故 ../deploy/agent/source.json → /deploy/agent/source.json）。
COPY deploy/agent/source.json /deploy/agent/source.json
# 站点直接展示的 Markdown：HistoryPage / TechnicalEvolutionPage 构建期以 ?raw 读取
COPY HISTORY.md /HISTORY.md
# Canonical 技术演进：TechnicalEvolutionPage 构建期以 ?raw 读取
COPY docs/architecture/TECHNICAL_EVOLUTION.md /docs/architecture/TECHNICAL_EVOLUTION.md
# League Rating V6 canonical 文档：RatingDocsPage 构建期以 ?raw 读取（.dockerignore 显式放行）
COPY docs/WotBTools_League_Rating_V6.md /docs/WotBTools_League_Rating_V6.md
ENV BUILD_COMMIT=${BUILD_COMMIT}
ENV VITE_ASSET_BASE_URL=${ASSET_BASE_URL}
RUN pnpm run build
# 构建后断言：Agent WASM 产物必须已随构建进 dist 且是 **commit-addressed** 的
# （`/wasm/<source.json ref>/`）——3D 回放/装甲查看器/射击复现的运行前提。校验实现与
# CI dist smoke 共用 `frontend/scripts/verify-agent-wasm-dist.mjs`：缺文件、fingerprint
# 与 source.json 不一致、wasm magic 缺失、或 stable 路径偷偷回归都会 fail-fast，
# 而不是发布一个打开即 "Failed to fetch dynamically imported module"（或加载到错版
# Agent）的镜像。
RUN node /app/scripts/verify-agent-wasm-dist.mjs --dist /app/dist --pin /deploy/agent/source.json
# 构建后断言：资产 origin 确实写进了 bundle。防"变量设了却未生效"的静默失败——
# ENV 名 / Vite 前缀（VITE_）/ 代码读取名（import.meta.env.VITE_ASSET_BASE_URL）三者
# 任一处漂移，都会得到"WORKFLOW 绿、线上仍提示未配置"的假成功。
# 留空只警告（CI 的 Validate production asset origin 步骤已对生产 fail-closed）；
# 非空则必须能在产物中找到，否则 fail。
RUN node -e 'const fs=require("fs"),path=require("path");const v=(process.env.VITE_ASSET_BASE_URL||"").trim();if(!v){console.warn("VITE_ASSET_BASE_URL is empty: building an image without an asset origin (3D assets will be unavailable)");process.exit(0)}const dir="/app/dist/assets";const hit=fs.readdirSync(dir).filter(f=>f.endsWith(".js")).some(f=>fs.readFileSync(path.join(dir,f),"utf8").includes(v));if(!hit)throw new Error("asset origin was not baked into the built bundle: "+v);console.log("asset origin baked into bundle: "+v)'

# 图片（地图底图 / 坦克图标等，占前端产物约 90%，文件名带内容哈希、很少变）单独成层，
# 并把产物 mtime 归零：配合构建时的 SOURCE_DATE_EPOCH + rewrite-timestamp，图片不变时该层
# 逐字节一致，registry 已有同 digest 的 blob，docker push 直接跳过——每次发布只需上传
# 几 MB 的 JS/CSS 层；即使改为 TX→TCR 国内发布，也继续减少每次 registry 上传与本地磁盘 I/O。
RUN mkdir -p /out/media/assets \
 && find /app/dist/assets -maxdepth 1 -type f \
      \( -name '*.webp' -o -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.svg' -o -name '*.glb' \) \
      -exec mv {} /out/media/assets/ \; \
 && find /out/media /app/dist -exec touch -h -d @0 {} +

FROM nginx:alpine
COPY --from=build /out/media /usr/share/nginx/html
COPY --from=build /app/dist /usr/share/nginx/html
# Sponsor uses the Vue SPA route; retain its page background at a stable public URL.
COPY frontend/public/sponsor-bg.webp /usr/share/nginx/html/sponsor-bg.webp
COPY common/assets/icon.ico common/assets/icon.png common/assets/wotbtoolslogo.png /usr/share/nginx/html/
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
