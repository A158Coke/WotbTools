FROM node:24-alpine AS build
# Build identity：CI 经 build-arg 注入 git commit（Docker 上下文无 .git，不能自行 rev-parse）。
ARG BUILD_COMMIT=unknown
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci
COPY frontend/ .
COPY common/map_names.json /common/map_names.json
# 隐藏 QA 页（?view=vehicle-models）动态 import Tankopedia 车辆库（仅 tier10）
COPY common/tankopedia-tier10.json /common/tankopedia-tier10.json
COPY common/assets /common/assets
# 站点直接展示的 Markdown：HistoryPage / TechnicalEvolutionPage 构建期以 ?raw 读取
COPY HISTORY.md /HISTORY.md
# Canonical 技术演进：TechnicalEvolutionPage 构建期以 ?raw 读取
COPY docs/architecture/TECHNICAL_EVOLUTION.md /docs/architecture/TECHNICAL_EVOLUTION.md
# League Rating V6 canonical 文档：RatingDocsPage 构建期以 ?raw 读取（.dockerignore 显式放行）
COPY docs/WotBTools_League_Rating_V6.md /docs/WotBTools_League_Rating_V6.md
ENV BUILD_COMMIT=${BUILD_COMMIT}
RUN npm run build
# 构建后断言：Agent WASM 产物（CI 里 fetch-agent-wasm.sh 落到 publicDir ../common/assets/wasm）
# 必须已随构建进 dist——3D 回放/装甲查看器/射击复现的运行前提。缺失时 fail-fast，
# 而不是发布一个页面打开即 "Failed to fetch dynamically imported module" 的镜像。
RUN node -e 'const fs=require("fs");const js="/app/dist/wasm/wotb_replay_wasm.js";const bin="/app/dist/wasm/wotb_replay_wasm_bg.wasm";for(const f of [js,bin]){if(!fs.existsSync(f))throw new Error("agent wasm artifact missing from dist: "+f);if(!fs.statSync(f).size)throw new Error("agent wasm artifact empty: "+f)}if(fs.readFileSync(bin).subarray(0,4).toString("hex")!=="0061736d")throw new Error("wotb_replay_wasm_bg.wasm lacks wasm magic");console.log("agent wasm artifacts present in dist")'

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Sponsor uses the Vue SPA route; retain its page background at a stable public URL.
COPY frontend/public/sponsor-bg.png /usr/share/nginx/html/sponsor-bg.png
COPY common/assets/icon.ico common/assets/icon.png common/assets/wotbtoolslogo.png /usr/share/nginx/html/
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
