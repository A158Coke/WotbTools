# MinIO Community Edition is source-only as of 2026. Build the final maintained
# upstream release ourselves so the production runtime never downloads it.
ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
ARG BUILD_COMMIT

FROM golang:1.24-bookworm AS build
ARG MINIO_RELEASE
ARG MINIO_COMMIT
RUN git init --quiet /src \
    && git -C /src remote add origin https://github.com/minio/minio.git \
    && git -C /src fetch --depth 1 origin \
        "refs/tags/$MINIO_RELEASE:refs/tags/$MINIO_RELEASE" "$MINIO_COMMIT" \
    && git -C /src checkout --detach --quiet "$MINIO_COMMIT" \
    && test "$(git -C /src rev-parse HEAD)" = "$MINIO_COMMIT" \
    && test "$(git -C /src rev-parse "$MINIO_RELEASE^{commit}")" = "$MINIO_COMMIT"
WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "$(go run buildscripts/gen-ldflags.go) -s -w" \
    -o /out/minio .

FROM debian:bookworm-slim
ARG MINIO_RELEASE
ARG MINIO_COMMIT
ARG BUILD_COMMIT
LABEL org.opencontainers.image.title="WotbTools MinIO" \
      org.opencontainers.image.version="${MINIO_RELEASE}" \
      org.opencontainers.image.upstream-revision="${MINIO_COMMIT}" \
      org.opencontainers.image.revision="${BUILD_COMMIT}" \
      org.opencontainers.image.source="https://github.com/minio/minio"
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
