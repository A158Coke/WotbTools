# Yecao `ai-service` — AI provider settings (owner: deploy/docker-compose.prod.yml,
# .github/workflows/ai-service.yml). The TX business runtime carries NO AI provider
# configuration or secret any more: TX only reverse-proxies /api/ai/** to the
# ai-service WireGuard endpoint (`TX_AI_UPSTREAM`, see the TX section below).
# Non-sensitive settings belong in GitHub Repository Variables (not Secrets);
# this file lists variable names only, never values.

# DeepSeek credentials (sensitive, use Secrets)
# AI_API_KEY=
# AI_BASE_URL=

# Model（官方稳定别名：deepseek-v4-flash 指向最新 Flash 版本，勿用带日期的显示名）
# AI_MODEL=

# Timeouts (seconds)
# AI_CONNECT_TIMEOUT_SEC=
# AI_TIMEOUT_SEC=
# AI_CALL_TIMEOUT_SEC=

# Retry (AI_CALL_TIMEOUT_SEC bounds the whole chat() lifecycle incl. retries)
# AI_RETRY_MAX_ATTEMPTS=
# AI_RETRY_INITIAL_BACKOFF_MS=
# AI_RETRY_MAX_BACKOFF_MS=
# AI_RETRY_BACKOFF_MULTIPLIER=

# Token budget
# AI_CONTEXT_WINDOW_TOKENS=
# AI_SINGLE_REPLAY_MAX_INPUT_TOKENS=
# AI_MAX_OUTPUT_TOKENS=
# AI_PROMPT_SAFETY_MARGIN_TOKENS=

# Reasoning
# Call #2 复盘默认关闭 thinking（保证 SSE 逐段流式）；需要推理深度时改为 true
# AI_THINKING_ENABLED_CALL2=
# legacy：全局 thinking 开关（Call #2 已由 AI_THINKING_ENABLED_CALL2 控制）
# AI_THINKING_ENABLED=
# AI Review 整体 deadline（秒）：覆盖团队 3 次 AI 调用（Call#1+Call#2+Autopsy，各 ≤315s）+ 余量；
# 对齐前端 1100s / TX ingress 1120s；超过则前端给出干净 AI_TIMEOUT。超时链由
# `AiTimeoutChainContractTest` 锁定，`ai-service` 的 Compose 默认值保持 1100。
# AI_REVIEW_WORKER_OVERALL_DEADLINE_SEC=
# AI_REASONING_EFFORT=

# Wargaming.net Blitz application ID (Keycloak WG identity provider + backend hundred-battle verification)
# WG_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Frontend Agent 3D asset origin（BUILD-TIME，不是 compose 运行时环境变量）
# 前端 3D 静态资产（GLB/地图/坦克数据）的 remote asset origin：经 build-arg 注入
# docker/Dockerfile.frontend（ASSET_BASE_URL → VITE_ASSET_BASE_URL），Vite 构建期
# 写进 bundle，普通用户无需在 URL 带 ?assets=。非敏感——填 GitHub Repository
# Variable `ASSET_BASE_URL`，不要填这里（本文件是 compose 运行时环境）。
# 必须是 https:// 开头且不带结尾 /（CI fail-closed 校验）；接通步骤、CORS 要求、
# 桶凭据归属与轮换注意事项见 docs/operations/agent-asset-origin.md。
# 当前生产值（资产包在桶根目录）：
# ASSET_BASE_URL=https://wotbtools-assets-1478073677.cos.ap-shanghai.myqcloud.com

# Tencent TCR is the primary TX runtime-image source. TX keeps its Docker
# credential store deployment-owned; do not put TCR_USERNAME/TCR_PASSWORD in
# Compose or application environments. Build and image-existence checks use the
# GitHub Repository Variables TCR_REGISTRY/TCR_NAMESPACE and Secrets
# TCR_USERNAME/TCR_PASSWORD.
TX_IMAGE_REGISTRY_PREFIX=ccr.ccs.tencentyun.com/wotbtools

# ---------------------------------------------------------------------------
# Observability (Prometheus / Loki / Grafana / Alloy)
# Required: Grafana admin account. Production values are injected by GitHub
# Actions Secrets; local docker/online needs them in .env (compose `required`
# syntax validates them). Example strong password: openssl rand -base64 24
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Grafana public URL (production domain)
GRAFANA_ROOT_URL=https://monitor.wotbtools.com

# Environment label (used to distinguish environments in Grafana/observability)
OBSERVABILITY_ENVIRONMENT=production
# ---------------------------------------------------------------------------
# Hall of Fame replay storage
# 名人堂回放文件内容寻址存储目录（生产容器内 /data/replays，compose 挂 replay_data volume）
# HOF_REPLAY_DIR=data/replays
# 磁盘保留阈值（字节，含本次写入大小）；低于则拒绝存储并返回 REPLAY_STORAGE_FULL(507)
# HOF_REPLAY_MIN_FREE_BYTES=536870912

# Runtime E2E check identity (`wotbtools-e2e`). Confidential, service-account only, and
# explicitly granted exactly the realm role `wotbtools-user` by infra/tofu/keycloak, so the
# read-only TX_RUNTIME_READY check can drive the real business chain and must still be
# rejected by admin endpoints. The secret is write-only in OpenTofu (same pattern as the
# Admin API client) and is injected through GitHub Actions Secrets.
KEYCLOAK_E2E_CLIENT_SECRET=
# Increment only when KEYCLOAK_E2E_CLIENT_SECRET changes (non-secret rotation version)
KEYCLOAK_E2E_CLIENT_SECRET_VERSION=1

# Explicit TX Business PostgreSQL deployment only. The bootstrap administrator
# is separate from the future Control API application role; OpenTofu on TX owns
# the database, role, and grant, and Flyway owns every table. Production values
# are GitHub Actions Variables/Secrets and are never stored in a TX env file.
TX_BUSINESS_POSTGRES_ADMIN_USER=
TX_BUSINESS_POSTGRES_ADMIN_PASSWORD=
TX_BUSINESS_DB_NAME=
TX_BUSINESS_DB_USERNAME=
TX_BUSINESS_DB_PASSWORD=
# Increment only when TX_BUSINESS_DB_PASSWORD changes (non-secret rotation version)
TX_BUSINESS_DB_PASSWORD_VERSION=

# TX business runtime (compose service `business-api`, selected explicitly). It runs the
# same backend image as the retired Yecao `wotb-backend` service and owns every public
# business endpoint. Replay parsing runs in the browser, so it has no replay job, broker or
# object-store configuration. Its app :8087 and management :8088 bind only to TX1 WireGuard, and it reuses the credentials already
# declared above: TX_BUSINESS_DB_* and KEYCLOAK_ADMIN_CLIENT_SECRET.
# It carries no AI provider configuration or secret: AI Review runs in the standalone Yecao
# ai-service, and TX only routes /api/ai/** to its WireGuard endpoint (`TX_AI_UPSTREAM`).
# Everything below is non-secret tuning with a Compose default.
# The public issuer must stay the public URL (Keycloak mints `iss` from its hostname);
# the Admin API is deliberately TX-internal so it can never administer the Yecao realm
# before the separately approved DNS cutover.
# KEYCLOAK_ISSUER_URI=https://auth.wotbtools.com/realms/wotbtools
# K6B logical endpoints default to Docker-local and may select only reviewed
# TX1/TX2 WireGuard addresses. Public hosts and wrong ports fail closed.
# Owner workflows pin the active value themselves; repository variables are not
# consulted for these placements. K6B-2A cut Frontend -> Business API over to
# http://10.20.0.1:8087 (TX1 WireGuard) in frontend.yml, K6B-2B cut Business API ->
# Business PostgreSQL over to 10.20.0.1:25432 (TX1 WireGuard), and K6B-2C cut Business
# API -> Keycloak Admin over to http://10.20.0.1:8080 (TX1 WireGuard), both in
# business-api.yml; the read-only runtime gate expects the same three values. Every
# other consumer is still the Docker-local placement and stays that way until its own
# K6B-2 step; the documented defaults below do not change. KEYCLOAK_ISSUER_URI stays the
# public realm URL: the issuer is token semantics, not a placement endpoint.
# TX_KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
# TX_KEYCLOAK_DB_HOST=keycloak-postgres
# TX_KEYCLOAK_DB_PORT=5432
# TX_BUSINESS_DB_HOST=business-postgres
# TX_BUSINESS_DB_PORT=5432
# TX_BACKEND_UPSTREAM=http://business-api:8087
# CADDY_FRONTEND_UPSTREAM=wotb-frontend:80
# CADDY_KEYCLOAK_UPSTREAM=keycloak:8080
# Public /api/ai/** is the only route that leaves TX: the standalone ai-service is
# pre-deployed on Yecao with no public port, so its upstream is the WireGuard address.
# Fail-closed in deploy/tx/deploy.sh (a public host, the business runtime, or another
# port is rejected before staging). No path rewrite: public and controller paths are
# both /api/ai/...
# TX_AI_UPSTREAM=http://10.20.0.2:8089

# ---------------------------------------------------------------------------
# Komodo controller plane (owner: deploy/komodo/compose.yml,
# .github/workflows/komodo-controller.yml). Repository-level GitHub Actions
# Secrets only: deliberately no GitHub Environment and no Yecao-local secret
# file. These are injected over SSH and never stored on the host.
KOMODO_DATABASE_PASSWORD=
KOMODO_INIT_ADMIN_PASSWORD=
# Persistent JWT and git-webhook secrets: Core must never generate them itself,
# or every restart would invalidate sessions and repo webhooks.
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=

# DNSPod / TencentCloud credentials for the Komodo OpenTofu root
# (infra/tofu/komodo). The Komodo controller workflow is the only owner allowed
# to read them; every other OpenTofu owner must keep failing closed without them.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Runtime check tuning (deploy/tx/runtime-check.sh). Everything below is non-secret.
# The check proves both public names are served by the TX address over a locally
# trusted certificate with 2xx. TLS verification is never disabled (-k is never used).
# KEYCLOAK_E2E_CLIENT_ID=wotbtools-e2e
# TX public address that must serve the public edge check.
# WOTB_E2E_PUBLIC_IP=118.25.18.105
