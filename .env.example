# WotbTools AI Review - DeepSeek 环境变量
# 这些是非敏感配置，应为 GitHub Repository Variables（不是 Secrets）

# DeepSeek API 凭据（此为敏感信息，使用 Secrets）
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com

# 模型配置
AI_MODEL=deepseek-v4-flash
AI_CONTEXT_WINDOW_TOKENS=1000000
AI_SINGLE_REPLAY_MAX_INPUT_TOKENS=940000
AI_MAX_OUTPUT_TOKENS=32768
AI_PROMPT_SAFETY_MARGIN_TOKENS=16384
AI_TIMEOUT_SEC=120

# 思考模式
AI_THINKING_ENABLED=true
AI_REASONING_EFFORT=high
