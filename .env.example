# WotbTools AI Review - DeepSeek environment variables
# Non-sensitive settings belong in GitHub Repository Variables (not Secrets).

# DeepSeek credentials (sensitive, use Secrets)
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com

# Model（官方稳定别名：deepseek-v4-flash 指向最新 Flash 版本，勿用带日期的显示名）
AI_MODEL=deepseek-v4-flash

# Timeouts (seconds)
AI_CONNECT_TIMEOUT_SEC=10
AI_TIMEOUT_SEC=300
AI_CALL_TIMEOUT_SEC=315

# Retry (AI_CALL_TIMEOUT_SEC bounds the whole chat() lifecycle incl. retries)
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_BACKOFF_MS=1000
AI_RETRY_MAX_BACKOFF_MS=8000
AI_RETRY_BACKOFF_MULTIPLIER=2.0

# Token budget
AI_CONTEXT_WINDOW_TOKENS=1000000
AI_SINGLE_REPLAY_MAX_INPUT_TOKENS=940000
AI_MAX_OUTPUT_TOKENS=32768
AI_PROMPT_SAFETY_MARGIN_TOKENS=16384

# Reasoning
# Call #2 复盘默认关闭 thinking（保证 SSE 逐段流式）；需要推理深度时改为 true
AI_THINKING_ENABLED_CALL2=false
# legacy：全局 thinking 开关（Call #2 已由 AI_THINKING_ENABLED_CALL2 控制）
AI_THINKING_ENABLED=true
# AI Review 整体 deadline（秒）：覆盖团队 3 次 AI 调用（Call#1+Call#2+Autopsy，各 ≤315s）+ 余量；
# 对齐前端 1100s / nginx 1120s；超过则前端给出干净 AI_TIMEOUT；必须保持 1100（部署时 fail-fast 校验）
AI_REVIEW_WORKER_OVERALL_DEADLINE_SEC=1100
AI_REASONING_EFFORT=max

# Wargaming.net Blitz application ID (Keycloak WG identity provider + backend hundred-battle verification)
# WG_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Observability (Prometheus / Loki / Grafana / Alloy)
# Required: Grafana admin account. Production values are injected by GitHub
# Actions Secrets; local docker/online needs them in .env (compose `required`
# syntax validates them). Example strong password: openssl rand -base64 24
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Grafana public URL (production domain)
GRAFANA_ROOT_URL=https://monitor.wotbtools.com

# Environment label (used to distinguish environments in Grafana/observability)
OBSERVABILITY_ENVIRONMENT=production
# ---------------------------------------------------------------------------
# Hall of Fame replay storage
# 名人堂回放文件内容寻址存储目录（生产容器内 /data/replays，compose 挂 replay_data volume）
# HOF_REPLAY_DIR=data/replays
# 磁盘保留阈值（字节，含本次写入大小）；低于则拒绝存储并返回 REPLAY_STORAGE_FULL(507)
# HOF_REPLAY_MIN_FREE_BYTES=536870912
# Replay Export Job（长任务导出）：临时目录 / TTL 分钟 / 并发 worker / 队列容量
REPLAY_EXPORT_JOB_DIR=/tmp/wotb-export-jobs
REPLAY_EXPORT_JOB_TTL_MINUTES=30
REPLAY_EXPORT_JOB_MAX_CONCURRENT=2
REPLAY_EXPORT_JOB_QUEUE_CAPACITY=4
REPLAY_PARSE_MAX_CONCURRENT=2
REPLAY_PARSE_QUEUE_CAPACITY=200
REPLAY_ARTIFACT_MAX_CONCURRENT=1
# Replay Processing Job（解析预览异步化）：临时输入目录 / result 缓存 TTL（与 Export Job 共用 worker 池配置）
REPLAY_PROCESSING_JOB_DIR=/tmp/wotb-replay-processing-jobs
REPLAY_PROCESSING_JOB_TTL_MINUTES=30
# Job/source/operationId 权威状态后端：memory（默认，单实例内存）/ jdbc（PostgreSQL 权威投影）
# TX 运行时使用 jdbc；缺省 memory 不改变既有部署行为
# WOTB_REPLAY_PROCESSING_JOB_REPOSITORY=memory
# 回放执行模式（单一正向枚举）：local（缺省，本进程解析）/ distributed（TX 控制面）
# distributed 要求 repository=jdbc，并要求下面的 MinIO/RabbitMQ 变量齐全；未知值启动即失败
# WOTB_REPLAY_EXECUTION_MODE=local
# 分布式控制面的 MinIO 工作区（control_api 身份；键布局 temp/jobs/<jobId>/{input,artifacts,result}/）
# YECAO_MINIO_ENDPOINT=10.20.0.2:9000
# YECAO_MINIO_BUCKET=wotbtools-temp
# YECAO_MINIO_CONNECT_TIMEOUT_SECONDS=10
# YECAO_MINIO_WRITE_TIMEOUT_SECONDS=60
# 分布式控制面的 RabbitMQ 连接（拓扑由 infra/tofu/rabbitmq 拥有；密码变量见下方 TX_RABBITMQ_*）
# TX_RABBITMQ_HOST=
# TX_RABBITMQ_PORT=5672
# TX_RABBITMQ_VHOST=/
# TX_RABBITMQ_CONTROL_API_USER=
# TX_RABBITMQ_CONTROL_API_PREFETCH=1
# TX_RABBITMQ_CONFIRM_TIMEOUT_SECONDS=10
# 控制面逻辑重试预算（仅 distributed）：worker 报 parser.failed(retryable=true) 后，控制面按 PG
# 权威状态在 attempt < max-attempts 时重派 attempt+1（同一 jobId，立即重派），否则转终态
# REPLAY_PARSER_MAX_ATTEMPTS=3
# Explicit Yecao MinIO deployment only (GitHub Actions Secrets; never commit values)
# worker = Yecao parser-worker identity; control_api = TX replay control-plane identity
YECAO_MINIO_ROOT_USER=
YECAO_MINIO_ROOT_PASSWORD=
YECAO_MINIO_WORKER_ACCESS_KEY=
YECAO_MINIO_WORKER_SECRET_KEY=
YECAO_MINIO_CONTROL_API_ACCESS_KEY=
YECAO_MINIO_CONTROL_API_SECRET_KEY=

# Explicit TX RabbitMQ deployment only. The bootstrap administrator is separate
# from the two application passwords; production values are GitHub Actions
# Variables/Secrets and are never stored in a TX env file.
TX_RABBITMQ_ADMIN_USER=
TX_RABBITMQ_ADMIN_PASSWORD=
TX_RABBITMQ_CONTROL_API_PASSWORD=
TX_RABBITMQ_PARSER_WORKER_PASSWORD=

# Explicit TX Business PostgreSQL deployment only. The bootstrap administrator
# is separate from the future Control API application role; OpenTofu on TX owns
# the database, role, and grant, and Flyway owns every table. Production values
# are GitHub Actions Variables/Secrets and are never stored in a TX env file.
TX_BUSINESS_POSTGRES_ADMIN_USER=
TX_BUSINESS_POSTGRES_ADMIN_PASSWORD=
TX_BUSINESS_DB_NAME=
TX_BUSINESS_DB_USERNAME=
TX_BUSINESS_DB_PASSWORD=
# Increment only when TX_BUSINESS_DB_PASSWORD changes (non-secret rotation version)
TX_BUSINESS_DB_PASSWORD_VERSION=

# TX business runtime (compose service `business-api`, selected explicitly). It runs the
# same backend image as the retired Yecao `wotb-backend` service and owns every public
# business endpoint plus the distributed replay control plane. It publishes no port, and
# it reuses the credentials already declared above: TX_BUSINESS_DB_*, the RabbitMQ
# `control-api` password, the MinIO `control_api` key pair, KEYCLOAK_ADMIN_CLIENT_SECRET,
# and AI_API_KEY. Everything below is non-secret tuning with a Compose default.
# The public issuer must stay the public URL (Keycloak mints `iss` from its hostname);
# the Admin API is deliberately TX-internal so it can never administer the Yecao realm
# before the separately approved DNS cutover.
# KEYCLOAK_ISSUER_URI=https://auth.wotbtools.com/realms/wotbtools
# KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
# TX_RABBITMQ_HOST=rabbitmq
# TX_RABBITMQ_PORT=5672
# TX_RABBITMQ_VHOST=/wotbtools
# TX_RABBITMQ_CONTROL_API_USER=control-api
# YECAO_MINIO_ENDPOINT=10.20.0.2:9000
# YECAO_MINIO_BUCKET=wotbtools-temp
# WOTB_REPLAY_EXECUTION_MODE=distributed
# WOTB_REPLAY_PROCESSING_JOB_REPOSITORY=jdbc

# Yecao parser-worker runtime (compose service `parser-worker`, selected explicitly). The
# credentials are the ones declared above: TX_RABBITMQ_PARSER_WORKER_PASSWORD and the
# YECAO_MINIO_WORKER_* MinIO identity. Everything below is non-secret tuning with a default.
PARSER_WORKER_RABBITMQ_HOST=10.20.0.1
PARSER_WORKER_RABBITMQ_PORT=5672
PARSER_WORKER_RABBITMQ_VHOST=/wotbtools
PARSER_WORKER_RABBITMQ_USERNAME=parser-worker
PARSER_WORKER_MINIO_ENDPOINT=10.20.0.2:9000
PARSER_WORKER_MINIO_BUCKET=wotbtools-temp
# Concurrency = parallel parses (one AMQP consumer each), aligned with REPLAY_PARSE_MAX_CONCURRENT
PARSER_WORKER_CONCURRENCY=2
# Per-consumer unacked backlog, NOT the concurrency: keep it small so a crash redelivers quickly
PARSER_WORKER_PREFETCH=1
# No retry-budget setting: retry policy is control-plane owned (new parser.request with attempt+1)
PARSER_WORKER_CONFIRM_TIMEOUT_SEC=10
PARSER_WORKER_SHUTDOWN_TIMEOUT_SEC=30
