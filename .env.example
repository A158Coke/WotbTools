# WotbTools AI Review - DeepSeek environment variables
# Non-sensitive settings belong in GitHub Repository Variables (not Secrets).

# DeepSeek credentials (sensitive, use Secrets)
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com

# Model（官方稳定别名：deepseek-v4-flash 指向最新 Flash 版本，勿用带日期的显示名）
AI_MODEL=deepseek-v4-flash

# Timeouts (seconds)
AI_CONNECT_TIMEOUT_SEC=10
AI_TIMEOUT_SEC=300
AI_CALL_TIMEOUT_SEC=315

# Retry (AI_CALL_TIMEOUT_SEC bounds the whole chat() lifecycle incl. retries)
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_BACKOFF_MS=1000
AI_RETRY_MAX_BACKOFF_MS=8000
AI_RETRY_BACKOFF_MULTIPLIER=2.0

# Token budget
AI_CONTEXT_WINDOW_TOKENS=1000000
AI_SINGLE_REPLAY_MAX_INPUT_TOKENS=940000
AI_MAX_OUTPUT_TOKENS=32768
AI_PROMPT_SAFETY_MARGIN_TOKENS=16384

# Reasoning
# Call #2 复盘默认关闭 thinking（保证 SSE 逐段流式）；需要推理深度时改为 true
AI_THINKING_ENABLED_CALL2=false
# legacy：全局 thinking 开关（Call #2 已由 AI_THINKING_ENABLED_CALL2 控制）
AI_THINKING_ENABLED=true
# AI Review 整体 deadline（秒）：覆盖团队 3 次 AI 调用（Call#1+Call#2+Autopsy，各 ≤315s）+ 余量；
# 对齐前端 1100s / nginx 1120s；超过则前端给出干净 AI_TIMEOUT；必须保持 1100（部署时 fail-fast 校验）
AI_REVIEW_WORKER_OVERALL_DEADLINE_SEC=1100
AI_REASONING_EFFORT=max

# Wargaming.net Blitz application ID (Keycloak WG identity provider + backend hundred-battle verification)
# WG_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Observability (Prometheus / Loki / Grafana / Alloy)
# Required: Grafana admin account. Production values are injected by GitHub
# Actions Secrets; local docker/online needs them in .env (compose `required`
# syntax validates them). Example strong password: openssl rand -base64 24
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Grafana public URL (production domain)
GRAFANA_ROOT_URL=https://monitor.wotbtools.com

# Environment label (used to distinguish environments in Grafana/observability)
OBSERVABILITY_ENVIRONMENT=production
# ---------------------------------------------------------------------------
# Hall of Fame replay storage
# 名人堂回放文件内容寻址存储目录（生产容器内 /data/replays，compose 挂 replay_data volume）
# HOF_REPLAY_DIR=data/replays
# 磁盘保留阈值（字节，含本次写入大小）；低于则拒绝存储并返回 REPLAY_STORAGE_FULL(507)
# HOF_REPLAY_MIN_FREE_BYTES=536870912
# Replay Export Job（长任务导出）：临时目录 / TTL 分钟 / 并发 worker / 队列容量
REPLAY_EXPORT_JOB_DIR=/tmp/wotb-export-jobs
REPLAY_EXPORT_JOB_TTL_MINUTES=30
REPLAY_EXPORT_JOB_MAX_CONCURRENT=2
REPLAY_EXPORT_JOB_QUEUE_CAPACITY=4
REPLAY_PARSE_MAX_CONCURRENT=2
REPLAY_PARSE_QUEUE_CAPACITY=200
REPLAY_ARTIFACT_MAX_CONCURRENT=1
# Replay Processing Job（解析预览异步化）：临时输入目录 / result 缓存 TTL（与 Export Job 共用 worker 池配置）
REPLAY_PROCESSING_JOB_DIR=/tmp/wotb-replay-processing-jobs
REPLAY_PROCESSING_JOB_TTL_MINUTES=30
