# WotbTools AI Review - DeepSeek 环境变量
# 这些是非敏感配置，应为 GitHub Repository Variables（不是 Secrets）

# DeepSeek API 凭据（此为敏感信息，使用 Secrets）
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com

# 模型配置
AI_MODEL=deepseek-v4-flash
AI_CONTEXT_WINDOW_TOKENS=1000000
AI_SINGLE_REPLAY_MAX_INPUT_TOKENS=940000
AI_MAX_OUTPUT_TOKENS=32768
AI_PROMPT_SAFETY_MARGIN_TOKENS=16384
AI_TIMEOUT_SEC=120

# 思考模式
AI_THINKING_ENABLED=true
AI_REASONING_EFFORT=high

# ── 观测系统（Prometheus / Loki / Grafana / Alloy） ──────────────────
# 必填：Grafana 管理员账号。生产环境由 GitHub Actions Secrets 注入；
# 本地 docker/online 启动观测栈时需在 .env 中提供（compose required 语法会校验）。
# 生成强密码示例：openssl rand -base64 24
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Grafana 对外访问地址（生产子域）
GRAFANA_ROOT_URL=https://monitor.wotbtools.com

# 环境标记（用于 Grafana/观测配置区分环境）
OBSERVABILITY_ENVIRONMENT=production

# Grafana MCP server（本地 docker/online 起 mcp-grafana 服务时用）
# GRAFANA_MCP_TOKEN_FILE：本地 Grafana Service Account Token 文件路径（容器挂载为 /token）
# GRAFANA_MCP_ALLOWED_HOST：Caddy 反代时放行的 Host（生产为 monitor.wotbtools.com）
# GRAFANA_MCP_TOKEN_FILE=
# GRAFANA_MCP_ALLOWED_HOST=localhost,127.0.0.1
