# Komodo Periphery target profile: Yecao (K3.1 target, since K3.2 one of two).
#
# Reviewed, non-secret host parameters only. The lifecycle scripts
# (`install.sh` / `reconcile.sh` / `verify.sh`) are target-agnostic and read this
# file through `load_target_profile`, so adding a host means adding a profile,
# never a second lifecycle implementation.
#
# No credential may ever be added here.

## The target name, which must equal the directory name and the staged runtime
## selector (`reconcile.sh <target> ...`).
PERIPHERY_TARGET=yecao

## The Server this host registers as in Komodo.
PERIPHERY_CONNECT_AS=yecao

## The host's existing mutation lock root, owned by the host's own deploy owner.
## Periphery serializes with every other Yecao mutation through it;
## `/opt/wotb/.deploy.lock` is shared with deploy.sh / observability / ai-service.
: "${PERIPHERY_LOCK_ROOT:=/opt/wotb}"

## SHA-scoped SCP staging root. Yecao's SSH account is root, so /opt/periphery is
## writable directly.
: "${PERIPHERY_STAGING_ROOT:=/opt/periphery}"

## root = the SSH account already is root. sudo = the reconcile needs
## non-interactive sudo (see the TX1 profile).
PERIPHERY_PRIVILEGE=root
