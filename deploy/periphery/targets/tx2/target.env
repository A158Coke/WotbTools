# Komodo Periphery target profile: TX2 (K3.3).
#
# Reviewed, non-secret host parameters only. The lifecycle scripts
# (`install.sh` / `reconcile.sh` / `verify.sh`) are target-agnostic and read this
# file through `load_target_profile`, so adding a host means adding a profile,
# never a second lifecycle implementation.
#
# No credential may ever be added here.

## The target name, which must equal the directory name and the staged runtime
## selector (`reconcile.sh <target> ...`).
PERIPHERY_TARGET=tx2

## The Server this host registers as in Komodo.
PERIPHERY_CONNECT_AS=tx2

## The host's existing mutation lock root, owned by TX2's deploy owner. Periphery
## serializes with every other mutation of that host through
## `/opt/wotb-tx2/.deploy.lock`; no independent TX2 Periphery lock exists, and
## Periphery never creates or replaces the lock file.
: "${PERIPHERY_LOCK_ROOT:=/opt/wotb-tx2}"

## SHA-scoped SCP staging root, deliberately under the host's deploy-owned root so
## SCP never needs a privileged write directly under /opt. The TX2 SSH account
## (`ubuntu`) is not root.
: "${PERIPHERY_STAGING_ROOT:=/opt/wotb-tx2/periphery}"

## sudo = the SSH account is not root; the reconcile re-executes itself through
## non-interactive sudo, preserving only the generic onboarding variable.
PERIPHERY_PRIVILEGE=sudo
