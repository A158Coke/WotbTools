# Komodo Periphery target profile: Alibaba Shanghai asset origin.
#
# Reviewed, non-secret host parameters only. The shared lifecycle scripts
# (`install.sh` / `reconcile.sh` / `verify.sh`) are identical to the existing
# Yecao/TX targets; this file contains only host-specific data.
#
# No credential may ever be added here.

PERIPHERY_TARGET=ali-sh-asset-01
PERIPHERY_CONNECT_AS=ali-sh-asset-01

# Yecao/TX default to the private Core port 9120. This host reaches Core through
# the public HTTPS/WSS ingress, so lifecycle verification must inspect :443.
PERIPHERY_CORE_PORT=443

# The asset host owns a single mutation root. Provision this root and its
# `.deploy.lock` once before enabling the production workflow; Periphery only
# consumes the lock and never creates or replaces it.
: "${PERIPHERY_LOCK_ROOT:=/opt/wotb-asset}"

# SHA-scoped SCP staging. The SSH account is the non-root `admin` user, so this
# directory is owned by that host operator account while reconcile escalates via
# non-interactive sudo for /etc, /usr/local/bin, and systemd mutations.
: "${PERIPHERY_STAGING_ROOT:=/opt/wotb-asset/periphery}"

PERIPHERY_PRIVILEGE=sudo
