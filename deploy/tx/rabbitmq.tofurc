# Production TX provisioning is mirror-only. Do not add a direct fallback:
# the host must never download a provider during a RabbitMQ apply.
provider_installation {
  filesystem_mirror {
    path    = "/opt/wotb-tx/tofu-provider-mirror"
    include = ["registry.opentofu.org/cyrilgdn/rabbitmq"]
  }

  direct {
    exclude = ["registry.opentofu.org/cyrilgdn/rabbitmq"]
  }
}
