// Alloy 配置 — TX 侧日志采集
// 采集 business-api、keycloak、wotb-frontend 三个业务容器的日志，经 WireGuard 转发到
// Yecao Loki（10.20.0.2:3100）。需要挂载 /var/run/docker.sock（见 docker-compose.yml）。
//
// 匹配用 com.docker.compose.service 标签而不是容器名：TX 的服务没有固定 container_name，
// 且容器名形如 <project>-<service>-1，`.*keycloak.*` 这类名字正则会同时命中
// keycloak-postgres。Loki 里的标签仍然归一化为退役前的旧名字
// （wotb-backend/keycloak/wotb-frontend），因此所有 Grafana 日志查询无需改动。

// Discover all containers once. Authoritative matching happens in the relabel
// rules below; keeping discovery unfiltered avoids version-dependent filter
// semantics (same rationale as the Yecao config). The refresh interval is
// explicit because the default is 60s: a business container (re)started in
// compose must be discovered well before any deployment gate asserts on its
// log stream, not up to a minute later.
discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

// business-api 的日志流沿用 wotb-backend 身份：backend 的指标 job 名、
// error-explorer/ai-review 的 {container_name="wotb-backend"} 查询都保持不变。
discovery.relabel "backend" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "business-api"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "container_name"
		replacement   = "wotb-backend"
	}
}

loki.source.docker "backend" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.backend.output
	forward_to = [loki.write.default.receiver]
}

discovery.relabel "keycloak" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "keycloak"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "container_name"
		replacement   = "keycloak"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "service"
		replacement   = "keycloak"
	}
}

loki.source.docker "keycloak" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.keycloak.output
	forward_to = [loki.process.compliance.receiver]
}

// Android APK 由 frontend nginx 直接静态托管，不经过 Spring Boot。
// 这里只采集 GET /download/android/*.apk 的 access log，并在写入 Loki 前丢弃
// 客户端 IP、Referer、User-Agent 等原始字段，只保留计数所需的文件名、状态码与字节数。
discovery.relabel "frontend" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "wotb-frontend"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "container_name"
		replacement   = "wotb-frontend"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "service"
		replacement   = "wotb-frontend"
	}
}

loki.source.docker "frontend" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.frontend.output
	forward_to = [loki.process.android_download.receiver]
}

loki.process "android_download" {
	forward_to = [loki.write.default.receiver]

	// 仅保留真实 APK GET；下载页、version.json、普通前端流量全部丢弃。
	stage.match {
		selector            = "{container_name=\"wotb-frontend\"} !~ \"GET /download/android/[^ ]+[.]apk\""
		action              = "drop"
		drop_counter_reason = "not_android_apk_download"
	}

	// nginx combined log: "GET /download/android/<apk> HTTP/1.1" <status> <bytes> ...
	stage.regex {
		expression = "\\\"(?P<method>GET) /download/android/(?P<apk>[^/? ]+\\.apk)(?:\\?[^ ]*)? HTTP/[^\\\"]+\\\" (?P<status>[0-9]{3}) (?P<bytes>[0-9]+)"
	}

	stage.template {
		source   = "sanitized"
		template = "event=android_apk_download method={{ .method }} apk={{ .apk }} status={{ .status }} bytes={{ .bytes }}"
	}

	stage.static_labels {
		values = {
			event = "android_apk_download",
		}
	}

	stage.output {
		source = "sanitized"
	}
}

// Caddy：broker 回调的访问日志（2.1.0 Phase 2 取证）。Caddyfile 在
// `/realms/*/broker/*` 上用 filter 编码器剥掉了 query 里的 code/state 与 Cookie /
// Authorization 头，因此这里收到的行**只有**脱敏后的 uri、User-Agent、status 与远端 IP。
// 标签归一化为 `container_name="caddy"`，与既有查询口径一致。
discovery.relabel "caddy" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "caddy"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.*)"
		target_label  = "container_name"
		replacement   = "caddy"
	}
}

loki.source.docker "caddy" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.caddy.output
	forward_to = [loki.process.compliance.receiver]
}

// 合规安全日志分流（公安自评估「日志信息留存措施」）。
//
// 这里**不替换**任何现有行为：Keycloak 与 Caddy 的所有日志行照旧原样流向
// loki.write.default，Grafana 既有查询口径不变。唯一的新增动作是给**真正属于安全日志**
// 的行打上两个低基数标签：
//   compliance="security"   -> Loki 据此把这些流的 retention 延长到 190 天
//   security_kind=...       -> 取证时区分认证事件 / API 访问 / 认证域访问
// 没有被打标的行（backend debug、AI telemetry、feature usage、APK 下载、Keycloak 的
// 普通 runtime 日志）继续走默认 7 天档。边界见 docs/operations/security-log-retention.md。
//
// stage.match 的 action 默认是 keep：命中 selector 的行执行嵌套 stage，未命中的行
// **原样透传**（不丢弃），因此一个 processor 里可以并列多个互不影响的分支。
loki.process "compliance" {
	forward_to = [loki.write.default.receiver]

	// Keycloak 受控安全事件（realm events 经 jboss-logging listener 写到 stdout）。
	// 事件类型清单与 infra/tofu/keycloak/events.tf 的 enabled_event_types 必须逐一对应
	// （scripts/ci/test-keycloak-tofu-contract.sh 断言两边一致）：jboss-logging listener
	// 本身不受 realm 的 enabled_event_types 约束（那只过滤数据库 event store），所以
	// 190 天留存的边界必须在这里显式收窄，否则全部事件类型都会被延长。
	// operationType= 是 admin event 的形态（admin_events_details_enabled = false，
	// 所以行里不含 resource representation）。
	// LogQL 的 line filter 只接受双引号字符串（反引号原样串在这个解析器里是 syntax
	// error），所以引号写成 \\\" 逐层转义；而双引号串里的 \. 会被 LogQL 判为非法转义，
	// 因此点号一律写成 [.]（与下方 Android selector 同一条既有约定）。
	stage.match {
		selector = "{container_name=\"keycloak\"} |~ \"org[.]keycloak[.]events\" |~ \"(type=\\\"(LOGIN|LOGIN_ERROR|LOGOUT|LOGOUT_ERROR|IDENTITY_PROVIDER_LOGIN|IDENTITY_PROVIDER_LOGIN_ERROR|IDENTITY_PROVIDER_FIRST_LOGIN)\\\"|operationType=\\\"(CREATE|UPDATE|DELETE|ACTION)\\\")\""

		stage.static_labels {
			values = {
				compliance    = "security",
				security_kind = "auth",
			}
		}
	}

	// Caddy 的受控安全访问日志。Caddyfile 用 log_append 在行里写死 compliance /
	// security_kind，所以这里既不猜 logger 名字（log0/log1 随声明顺序漂移），也不在
	// Alloy 侧第二次定义「哪些访问日志算安全日志」：唯一事实源是 deploy/tx/Caddyfile。
	// 其余 Caddy 行（TLS/ACME/reload 等 runtime 日志）不含该字段，照旧走 7 天档。
	stage.match {
		selector = "{container_name=\"caddy\"} |~ \"\\\"compliance\\\":\\\"security\\\"\""

		stage.json {
			expressions = {
				security_kind = "security_kind",
			}
		}

		stage.labels {
			values = {
				security_kind = "security_kind",
			}
		}

		stage.static_labels {
			values = {
				compliance = "security",
			}
		}
	}
}

// Yecao Loki 的 WireGuard-only 摄入端口（deploy/docker-compose.prod.yml）。
// E2E smoke 测试网络里不存在 WireGuard 地址，因此允许用 WOTB_LOKI_URL 覆盖；
// 生产 compose 不设置该变量，端点保持 10.20.0.2:3100 不变。
loki.write "default" {
	endpoint {
		url = coalesce(env("WOTB_LOKI_URL"), "http://10.20.0.2:3100/loki/api/v1/push")
	}
}
