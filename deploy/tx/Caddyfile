{
	# The address is supplied only at TX runtime; no account material belongs in
	# this repository or in the Compose file.
	email {$CADDY_ACME_EMAIL}
	# HTTP/3 必须保持关闭：TX 安全组没有放行 UDP 443，QUIC 握手包被静默丢弃。
	# 若广告 Alt-Svc h3（Caddy 对 TLS 站点默认开启），Chromium 系浏览器会缓存该
	# 声明（ma=3d），之后每次访问先走 QUIC、等握手失败才回退 TCP，用户侧表现为
	# 网页永远加载中；而带宽受限的公网管道（TX1 5Mbps）也拿不到 h3 的收益。
	# 重新启用的前提是安全组先放行 UDP 443 并实测 QUIC 握手成功。
	servers {
		protocols h1 h2
	}
}

# TX-local readiness surface. K7C keeps both reviewed frontend instances behind
# the same public gateway while Keycloak remains on its reviewed placement.
# Steady-state frontend traffic is weighted 20% to TX1 and 80% to TX2; both peers
# are continuously health-checked and release parity is enforced separately.
# Caddy itself is the production public ingress and owns 80/443 by default
# (see docker-compose.yml).
http://caddy {
	handle /.well-known/assetlinks.json {
		root * /srv
		file_server
	}

	handle /_wotb/ready {
		respond "ready" 200
	}

	handle_path /_wotb/frontend/* {
		reverse_proxy {$CADDY_FRONTEND_UPSTREAM} {$CADDY_FRONTEND_PEER} {
			lb_policy weighted_round_robin 2 8
			health_uri /version.json
			health_interval 10s
			health_timeout 3s
			header_up Host wotbtools.com
		}
	}

	handle_path /_wotb/keycloak/* {
		reverse_proxy {$CADDY_KEYCLOAK_UPSTREAM} {
			header_up Host auth.wotbtools.com
		}
	}

	# TX-local readiness surface for the monitor route: proves the WireGuard
	# upstream to the Yecao Grafana without public DNS or a certificate.
	handle_path /_wotb/monitor/* {
		reverse_proxy 10.20.0.2:3000
	}

	handle {
		respond "not found" 404
	}
}

www.wotbtools.com {
	redir https://wotbtools.com{uri} permanent
}

wotbtools.com {
	# Exact Android origin; native Bearer authentication never needs cookies.
	@android {
		header Origin https://appassets.androidplatform.net
		path /api/* /agent-assets/* /download/android/version.json
	}
	@androidPreflight {
		header Origin https://appassets.androidplatform.net
		method OPTIONS
		path /api/* /agent-assets/* /download/android/version.json
	}
	route {
	header @android {
		Access-Control-Allow-Origin https://appassets.androidplatform.net
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, Content-Encoding, Accept"
		Access-Control-Expose-Headers "Content-Disposition, X-Request-ID, X-Map-Meta"
		+Vary Origin
	}
	respond @androidPreflight "" 204
	# 2026-10-06: APK downloads offloaded to Tsinghua Cloud dir-share; TX1's 5Mbps
	# public pipe was saturated by 15MB apk downloads. Only *.apk is redirected —
	# version.json and *.staging.json stay origin-served (the deploy preflight
	# compares TX1/TX2 frontend content directly). The share link is owned together
	# with the android-release workflow step; changing it requires both sides.
	@apkDownload {
		path_regexp apkFile ^/download/android/[^/]+\.apk$
	}
	redir @apkDownload https://cloud.tsinghua.edu.cn/d/909496de42424204ae11/files/?p=/{http.request.uri.path.file}&dl=1 302
	# Existing reviewed COS plane; fixed upstream cannot proxy arbitrary URLs.
	handle_path /agent-assets/* {
		reverse_proxy https://wotbtools-assets-1478073677.cos.ap-shanghai.myqcloud.com {
			header_up Host wotbtools-assets-1478073677.cos.ap-shanghai.myqcloud.com
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
		}
	}
	handle {
		reverse_proxy {$CADDY_FRONTEND_UPSTREAM} {$CADDY_FRONTEND_PEER} {
			lb_policy weighted_round_robin 2 8
			health_uri /version.json
			health_interval 10s
			health_timeout 3s
			header_up Host {host}
		}
	}
	}
}

auth.wotbtools.com {
	# 受控访问日志（2.1.0 Phase 2 取证）：Caddy 的 `log` 不是 ordered HTTP handler，
	# 既不能挂进 `handle` 也不能放进 `route`（两者都被 caddy adapt 拒绝），所以它是**站点级**的；
	# 路径筛选交给 Loki 查询（broker 回调 = uri 含 /realms/*/broker/*）。
	# filter 编码器在**写 stdout 之前**剥掉秘密：query 里的 code / state / session_state / iss
	# （OAuth 授权码与会话标识）与 Cookie / Authorization 头（Caddy 默认即不记录凭据，这里显式删除）。
	# 保留的 uri 其余部分、User-Agent、status、远端 IP 足以分辨"真实用户 vs 机器人"与客户端类型
	# （docs/auth/web-qq-diagnostics.md §3.4）；校验见 deploy/tx/validate-caddy-config.sh。
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
					delete session_state
					delete iss
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
	handle /.well-known/assetlinks.json {
		root * /srv
		file_server
	}

	# App Link 回跳地址。Android 用 external user-agent 走 Authorization Code + PKCE，
	# 2.1.0 起 **Android 授权回程固定 private scheme**（`com.wotbtools.app:/oauth2redirect`，
	# 不依赖 domain verification / 用户设置 / OEM 行为）；这条 HTTPS 路径**降级为兼容回退**：
	#   - 2.0.x 旧版本 APK 的交易（回程仍是 HTTPS）会落到这里；
	#   - 设备没能处理 private scheme 时，浏览器也会停在这里。
	# 两种情况下页面都提供「返回 WotBTools App」按钮，并把本页持有的 OAuth 响应
	# （location.search，含 code/state）原样转发给 private scheme——否则 App 侧
	# AuthResponseGuard 收不到响应、交易永远 pending。
	# 该路径以前会落到 Keycloak 的 catch-all 得到 404「页面不存在」，用户无法理解，也没有下载入口。
	# `handle` 按最长前缀匹配，这个更具体的路径优先于下方 catch-all，因此 Keycloak 的
	# 所有真实路径（/realms/...、/resources/...、/.well-known/...）行为不变。
	handle /android/oauth/callback {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond <<HTML
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>返回 WotBTools App</title>
</head>
<body style="font-family:sans-serif;max-width:30em;margin:2em auto;padding:0 1em;line-height:1.6">
<h1>返回 WotBTools App</h1>
<p>登录已完成。请回到 WotBTools App 继续使用。</p>
<p><a id="return-app" href="com.wotbtools.app:/oauth2redirect"
      style="display:inline-block;padding:.6em 1.2em;border:1px solid #555;border-radius:.4em;text-decoration:none">返回 WotBTools App</a></p>
<p id="return-app-hint" hidden>本页保留了登录结果；点击上面的按钮会把它交回 App。</p>
<p>如果你还没有安装：<a href="https://wotbtools.com/download/android">从 wotbtools.com 下载</a>。</p>
<p>Login is complete. Please return to the WotBTools app. Not installed yet? <a href="https://wotbtools.com/download/android">Download it from wotbtools.com</a>.</p>
<script>
// 兜底按钮不是主认证机制：2.1.0 起授权回程固定走 private scheme，浏览器只有在
// 「旧版本 APK 以 HTTPS 回程发起的交易」或「设备没能处理 private scheme」时才会停在本页。
// 这两种情况下本页持有完整的 OAuth 响应（code/state/...），必须原样转发给 App，
// 否则 App 侧 AuthResponseGuard 收不到响应、交易永远 pending。
(function () {
  var search = location.search || '';
  if (!search) return;
  var link = document.getElementById('return-app');
  link.href = 'com.wotbtools.app:/oauth2redirect' + search;
  document.getElementById('return-app-hint').hidden = false;
})();
</script>
</body>
</html>
HTML
	}

	handle {
		reverse_proxy {$CADDY_KEYCLOAK_UPSTREAM} {
			header_up Host {host}
		}
	}
}

# The public monitoring surface. Grafana itself runs on Yecao and is bound to
# the WireGuard address only (10.20.0.2:3000); Caddy terminates TLS and proxies
# without touching the Host header so Grafana's root URL stays
# https://monitor.wotbtools.com. DNS for this name must point at the TX
# address (118.25.18.105) for the certificate to issue.
monitor.wotbtools.com {
	reverse_proxy 10.20.0.2:3000
}

# The Komodo control-plane surface. Komodo Core runs on Yecao under its own owner
# (deploy/komodo, .github/workflows/komodo-controller.yml) and publishes only the
# WireGuard address 10.20.0.2:9120; Caddy terminates TLS and proxies over
# WireGuard, so no Komodo port is ever exposed on Yecao. The Host header is left
# untouched because KOMODO_HOST is already https://komodo.wotbtools.com. DNS for
# this name is owned by the Komodo OpenTofu root (infra/tofu/komodo) and must
# point at the TX address (118.25.18.105) for the certificate to issue.
komodo.wotbtools.com {
	reverse_proxy 10.20.0.2:9120
}
