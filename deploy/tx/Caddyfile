{
	# The address is supplied only at TX runtime; no account material belongs in
	# this repository or in the Compose file.
	email {$CADDY_ACME_EMAIL}
}

# TX-local readiness surface. Docker Compose resolves the Caddy service name,
# so the loaded config and both upstream routes can be validated without public
# HTTP redirects or ACME certificates; Caddy itself is the production public
# ingress and owns 80/443 by default (see docker-compose.yml).
http://caddy {
	handle /.well-known/assetlinks.json {
		root * /srv
		file_server
	}

	handle /_wotb/ready {
		respond "ready" 200
	}

	handle_path /_wotb/frontend/* {
		reverse_proxy wotb-frontend:80 {
			header_up Host wotbtools.com
		}
	}

	handle_path /_wotb/keycloak/* {
		reverse_proxy keycloak:8080 {
			header_up Host auth.wotbtools.com
		}
	}

	# TX-local readiness surface for the monitor route: proves the WireGuard
	# upstream to the Yecao Grafana without public DNS or a certificate.
	handle_path /_wotb/monitor/* {
		reverse_proxy 10.20.0.2:3000
	}

	handle {
		respond "not found" 404
	}
}

www.wotbtools.com {
	redir https://wotbtools.com{uri} permanent
}

wotbtools.com {
	reverse_proxy wotb-frontend:80 {
		header_up Host {host}
	}
}

auth.wotbtools.com {
	handle /.well-known/assetlinks.json {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy keycloak:8080 {
			header_up Host {host}
		}
	}
}

# The public monitoring surface. Grafana itself runs on Yecao and is bound to
# the WireGuard address only (10.20.0.2:3000); Caddy terminates TLS and proxies
# without touching the Host header so Grafana's root URL stays
# https://monitor.wotbtools.com. DNS for this name must point at the TX
# address (118.25.18.105) for the certificate to issue.
monitor.wotbtools.com {
	reverse_proxy 10.20.0.2:3000
}

# The Komodo control-plane surface. Komodo Core runs on Yecao under its own owner
# (deploy/komodo, .github/workflows/komodo-controller.yml) and publishes only the
# WireGuard address 10.20.0.2:9120; Caddy terminates TLS and proxies over
# WireGuard, so no Komodo port is ever exposed on Yecao. The Host header is left
# untouched because KOMODO_HOST is already https://komodo.wotbtools.com. DNS for
# this name is owned by the Komodo OpenTofu root (infra/tofu/komodo) and must
# point at the TX address (118.25.18.105) for the certificate to issue.
komodo.wotbtools.com {
	reverse_proxy 10.20.0.2:9120
}
