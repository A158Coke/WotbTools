# TX frontend nginx: public traffic reaches this container only through Caddy
# on wotb_tx_internal. API traffic is served by the TX business runtime.
server {
    listen 80;
    server_name wotbtools.com;
    client_max_body_size 200m;
    charset utf-8;

    # Caddy is the only public ingress. Docker resolves this trusted peer at
    # nginx startup, so the address can be dynamically assigned.
    set_real_ip_from caddy;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    index index.html;

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    # 前端 build 身份 + native 运行面（由 vite build 生成，内容取自
    # frontend/src/platform/nativeBridgeContract.js）。它是「线上前端是否支持 Bridge v2 /
    # native-auth」这条发布门禁的机器可读来源，因此绝不允许被缓存层返回旧副本。
    location = /version.json {
        default_type application/json;
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    location /assets/ {
        # 不加 always：add_header 默认只作用于 2xx/3xx。哈希文件名依赖「index 与
        # 资产来自同一 build」，双实例版本偏差或部署窗口期会出现瞬时 404；404 一旦
        # 继承 immutable 就会被浏览器缓存一年，用户侧应用永远启动不了（2026-10-06
        # 线上事故）。404 不携带本头，浏览器稍后重试即可自愈。
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Agent WASM 产物：commit-addressed 目录（`/wasm/<40 位 upstream commit>/`）。
    # 目录名就是内容身份——同一个 frontend build 只引用自己 pin 的 commit，新 Agent
    # → 新 URL，旧 URL 永不覆盖，因此长期 immutable 缓存是**正确**行为（刷新即拿到
    # 新 build 对应的产物，不需要 Ctrl+F5 / 清站点数据）。只锁 40 位 hex 目录，不给
    # `/wasm/` 根目录统一 immutable（根目录不得再放 stable 产物）。
    # 正则含 `{}`：必须加引号，否则 nginx 在 `{` 处提前结束 location 头
    #（`nginx: [emerg] unknown directive "40}/"`）。
    location ~ "^/wasm/[0-9a-f]{40}/" {
        # 同 /assets/：不加 always，404（如双实例偏差下 loader 拉 peer 上不存在的
        # commit 目录）不得被缓存一年。
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /download/android {
        try_files /index.html =404;
    }

    location = /download/android/ {
        try_files /index.html =404;
    }

    location = /download/android/version.json {
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    location /download/android/ {
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 独立 AI 微服务（Yecao 预部署，仅 WireGuard 10.20.0.2:8089 可达，无公网端口）。
    # 公开路径与 ai-service controller 路径保持一致（/api/ai/reviews...），因此
    # proxy_pass 不带 URI：绝不重写 path。
    # ^~ 前缀优先于下方通用 location /api/，AI 流量不会落到 TX Business Backend。
    # 超时链：SseEmitter 1120s / 应用整体 deadline 1100s（AI_REVIEW_WORKER_OVERALL_DEADLINE_SEC，
    # 单次上游调用预算 315s），代理必须 ≥1120s 才不会先于应用 504；SSE 需 HTTP/1.1 +
    # 清空 Connection + 关闭响应缓冲，Authorization 必须原样转发给 ai-service。
    location ^~ /api/ai/ {
        proxy_pass ${AI_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        add_header X-Accel-Buffering no always;
        proxy_read_timeout 1120s;
        proxy_send_timeout 1120s;
    }

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }
}
