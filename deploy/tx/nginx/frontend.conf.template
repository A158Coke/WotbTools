# TX frontend nginx: public traffic reaches this container only through Caddy
# on wotb_tx_internal. API traffic is served by the TX business runtime.
limit_req_zone $binary_remote_addr zone=replay_api:10m rate=1r/s;
limit_req_zone $binary_remote_addr zone=client_events:1m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=replay_api_conn:10m;

server {
    listen 80;
    server_name wotbtools.com;
    client_max_body_size 200m;
    charset utf-8;

    # Caddy is the only public ingress. Docker resolves this trusted peer at
    # nginx startup, so the address can be dynamically assigned.
    set_real_ip_from caddy;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    index index.html;

    location = /sponsor-config.json {
        default_type application/json;
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    location ^~ /sponsor-assets/ {
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /download/android {
        try_files /index.html =404;
    }

    location = /download/android/ {
        try_files /index.html =404;
    }

    location = /download/android/version.json {
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    location /download/android/ {
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /api/preview {
        limit_req zone=replay_api burst=10 nodelay;
        limit_conn replay_api_conn 5;
        limit_req_status 429;
        limit_conn_status 503;
        proxy_pass ${BACKEND_UPSTREAM}/api/preview;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location = /api/export {
        limit_req zone=replay_api burst=10 nodelay;
        limit_conn replay_api_conn 5;
        limit_req_status 429;
        limit_conn_status 503;
        proxy_pass ${BACKEND_UPSTREAM}/api/export;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location = /api/performance {
        limit_req zone=replay_api burst=10 nodelay;
        limit_conn replay_api_conn 5;
        limit_req_status 429;
        limit_conn_status 503;
        proxy_pass ${BACKEND_UPSTREAM}/api/performance;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # 独立 AI 微服务（Yecao 预部署，仅 WireGuard 10.20.0.2:8089 可达，无公网端口）。
    # 公开路径与 ai-service controller 路径保持一致（/api/ai/reviews...），因此
    # proxy_pass 不带 URI：绝不重写 path。
    # ^~ 前缀优先于下方通用 location /api/，AI 流量不会落到 TX Business Backend。
    # 超时链：SseEmitter 1120s / 应用整体 deadline 1100s（AI_REVIEW_WORKER_OVERALL_DEADLINE_SEC，
    # 单次上游调用预算 315s），代理必须 ≥1120s 才不会先于应用 504；SSE 需 HTTP/1.1 +
    # 清空 Connection + 关闭响应缓冲，Authorization 必须原样转发给 ai-service。
    location ^~ /api/ai/ {
        proxy_pass ${AI_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        add_header X-Accel-Buffering no always;
        proxy_read_timeout 1120s;
        proxy_send_timeout 1120s;
    }

    # Per-client telemetry budget uses the trusted Caddy real-IP contract above.
    location = /api/observability/client-events {
        client_max_body_size 4k;
        client_body_timeout 5s;
        limit_req zone=client_events burst=3 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_UPSTREAM}/api/observability/client-events;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }
}
