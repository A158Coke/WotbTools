{
	admin off
}

assets.wotbtools.com {
	root * /srv/wotb-assets/current

	# Web fetches are cross-origin. Reflect only the two production site origins;
	# Android uses its native proxy and does not depend on browser CORS.
	@allowed_origin header_regexp Origin ^https://(www\.)?wotbtools\.com$
	header @allowed_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, Etag, Last-Modified"
		Vary "Origin"
	}

	@preflight {
		method OPTIONS
		header_regexp Origin ^https://(www\.)?wotbtools\.com$
	}
	header @preflight Access-Control-Max-Age "600"
	respond @preflight 204

	# Current asset filenames are not content-addressed yet; do not use immutable or
	# a year-long TTL until the package is moved behind a versioned path.
	header Cache-Control "public, max-age=300, must-revalidate"

	file_server
}
