{
	admin off
}

assets.wotbtools.com {
	root * /srv/wotb-assets/current

	# Every cacheable response varies by Origin, including requests with no Origin or
	# an untrusted Origin. Otherwise a shared cache can reuse a headerless response
	# for an allowed browser request and cause a transient CORS failure.
	header +Vary "Origin"

	# Web fetches are cross-origin. Reflect only the two production site origins;
	# Android uses its native proxy and does not depend on browser CORS.
	@allowed_origin header_regexp Origin ^https://(www\.)?wotbtools\.com$
	header @allowed_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, Etag, Last-Modified"
	}

	@preflight {
		method OPTIONS
		header_regexp Origin ^https://(www\.)?wotbtools\.com$
	}
	header @preflight Access-Control-Max-Age "600"
	respond @preflight 204

	# Current asset filenames are not content-addressed yet; do not use immutable or
	# a year-long TTL until the package is moved behind a versioned path.
	header Cache-Control "public, max-age=300, must-revalidate"

	# Android releases live outside the replaceable Agent tree.
	@android path /android /android/*
	handle @android {
		root * /srv/wotb-downloads
		route {
			header Cache-Control "no-store"
			@artifact {
				method GET HEAD
				path_regexp androidArtifact ^/android/(wotbtools-android-v[0-9]+\.[0-9]+\.[0-9]+\.apk|wotbtools-android-delta-[0-9]+-[0-9]+-[0-9a-f]{64}\.vcdiff)$
				file {path}
			}
			handle @artifact {
				header {
					Cache-Control "no-store"
					match status 4xx 5xx
				}
				header {
					Cache-Control "public, max-age=31536000, immutable"
					match status 200 206 304
				}
				file_server
			}
			respond "not found" 404
		}
	}

	# Versioned datasets: /v/<dataset_id>/... -> /srv/wotb-assets/datasets/<id>/...
	# `handle_path` strips the /v prefix; the dataset tree is immutable per release
	# (datasets/<id> is a symlink, flipped atomically by deploy/assets/dataset.sh).
	handle_path /v/* {
		root * /srv/wotb-assets/datasets
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# Diff pairs are independent of the default dataset and retain their release paths.
	handle /diffs/index.json {
		root * /srv/wotb-assets
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	handle_path /diffs/* {
		root * /srv/wotb-assets/diffs
		file_server
	}

	# Host-level version catalog (frontend selector source). Short TTL so a dataset
	# publish/rollback is visible without waiting for the content TTL.
	handle /versions.json {
		root * /srv/wotb-assets
		rewrite * /versions.json
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	# Legacy root = current -> the default dataset (old clients keep working).
	file_server
}
