// Yecao telemetry: exact Compose service labels exclude databases and unrelated containers.
discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "ai" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "ai-service"
		action        = "keep"
	}

	rule {
		target_label = "service"
		replacement  = "ai-service"
	}

	rule {
		target_label = "container_name"
		replacement  = "ai-service"
	}
}

loki.source.docker "ai" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.ai.output
	forward_to = [loki.write.default.receiver]
}

discovery.relabel "parser" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "parser-worker"
		action        = "keep"
	}

	rule {
		target_label = "service"
		replacement  = "parser-worker"
	}

	rule {
		target_label = "container_name"
		replacement  = "parser-worker"
	}
}

loki.source.docker "parser" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.parser.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
