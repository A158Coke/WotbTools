// Alloy 配置 — WotBTools 观测栈
// 采集 wotb-backend 与 keycloak 容器的 stdout/stderr 日志，转发到 Loki。
// 需要挂载 /var/run/docker.sock（见 docker-compose）。

discovery.docker "backend" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "name"
		values = [".*wotb-backend.*"]
	}
}

discovery.relabel "backend" {
	targets = discovery.docker.backend.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = ".*wotb-backend.*"
		action        = "keep"
	}
	// 将容器名规范化为 wotb-backend（实际容器名形如 <project>-wotb-backend-1），
	// 供 Loki 查询 {container_name="wotb-backend"}
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = ".*(wotb-backend).*"
		target_label  = "container_name"
		replacement   = "$1"
	}
}

loki.source.docker "backend" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.backend.output
	forward_to = [loki.write.default.receiver]
}

discovery.docker "keycloak" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "name"
		values = [".*keycloak.*"]
	}
}

discovery.relabel "keycloak" {
	targets = discovery.docker.keycloak.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = ".*keycloak.*"
		action        = "keep"
	}
	// 将容器名规范化为 keycloak，避免 compose project name 进入查询语义。
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = ".*(keycloak).*"
		target_label  = "container_name"
		replacement   = "$1"
	}
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = ".*(keycloak).*"
		target_label  = "service"
		replacement   = "$1"
	}
}

loki.source.docker "keycloak" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.keycloak.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
