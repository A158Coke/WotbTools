    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "来源服务",
        "type": "custom",
        "query": "All : .+,wotb-backend,ai-service,keycloak,caddy",
        "current": {
          "text": "All",
          "value": ".+"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "keyword",
        "label": "关键词（原样文本）",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "errorId",
        "label": "Error ID（原样文本）",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "使用方式",
      "options": {
        "mode": "markdown",
        "content": "按时间、来源服务、关键词、Error ID 筛选。关键词和 ID 为原样子串。各分区可重叠；原始日志中保留来源容器和详细字段。客户端解析错误为 client-reported。最多查询最近 7 天。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "type": "row",
      "title": "账号与登录",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "账号与登录 · 日志",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "{container_name=~\"${service:raw}\"} |~ `(?i)(\"level\"[[:space:]]*:[[:space:]]*\"(error|warn)\"|[[:space:]](ERROR|WARN)[[:space:]]|api_request_failed|api_request_rejected|event=(ai_review_error|ai_upstream_call_failed|ai_review_contract_failed|ai_review_recovery_failed)|LOGIN_ERROR|IDENTITY_PROVIDER_LOGIN_ERROR|outcome=failure)` |= ${keyword:doublequote} |= ${errorId:doublequote} |~ \"(?i)(keycloak|LOGIN_ERROR|IDENTITY_PROVIDER|/api/(admin/)?(auth|user|profile)|/realms/|AUTH_|TOKEN_|UNAUTHORIZED|FORBIDDEN)\"",
          "refId": "A",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      }
    },
