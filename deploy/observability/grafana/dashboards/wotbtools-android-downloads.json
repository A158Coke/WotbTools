{
  "uid": "wotbtools-android-downloads",
  "title": "Android downloads",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "wotbtools",
    "operations"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Active users",
      "type": "link",
      "url": "/d/wotbtools-active-users",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Feature usage",
      "type": "link",
      "url": "/d/wotbtools-feature-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Android downloads",
      "type": "link",
      "url": "/d/wotbtools-android-downloads",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "AI token usage",
      "type": "link",
      "url": "/d/wotbtools-ai-token-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "统计口径",
      "options": {
        "mode": "markdown",
        "content": "仅统计 Web `/download/android` 页面最终「下载 APK」按钮的点击次数。进入下载页不计数；后续 302、文件传输是否完成、是否安装均不属于本指标。客户端遥测为 best-effort，可能少量丢失。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "下载 APK 点击次数",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "所选时间范围内最终 APK 下载按钮被点击的总次数。",
      "targets": [
        {
          "expr": "sum(count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"feature_open\" | feature=\"android_download\" | platform=\"web\" | keep telemetry_event [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "下载点击趋势",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "按 Grafana 自动时间桶聚合最终 APK 下载按钮点击次数。",
      "targets": [
        {
          "expr": "sum(count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"feature_open\" | feature=\"android_download\" | platform=\"web\" | keep telemetry_event [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "下载 APK 点击"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      }
    }
  ],
  "description": "Android APK download-button clicks received as best-effort product telemetry. No data means no matching received events, not verified zero usage."
}
