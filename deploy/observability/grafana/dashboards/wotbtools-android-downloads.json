{
  "uid": "wotbtools-android-downloads",
  "title": "Android downloads",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "wotbtools",
    "operations"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Active users",
      "type": "link",
      "url": "/d/wotbtools-active-users",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Feature usage",
      "type": "link",
      "url": "/d/wotbtools-feature-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Android downloads",
      "type": "link",
      "url": "/d/wotbtools-android-downloads",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "AI token usage",
      "type": "link",
      "url": "/d/wotbtools-ai-token-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "统计口径",
      "options": {
        "mode": "markdown",
        "content": "APK HTTP 请求次数，按文件版本和状态统计。200 是完整响应请求；206 是分段响应请求，可能由一次下载产生多个请求。两者均不代表安装人数。重试可能重复计数。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "完整响应请求（200）",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(count_over_time({container_name=\"wotb-frontend\",event=\"android_apk_download\"} | logfmt | status=\"200\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "分段响应请求（206）",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(count_over_time({container_name=\"wotb-frontend\",event=\"android_apk_download\"} | logfmt | status=\"206\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "按版本与状态",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum by (apk, status) (count_over_time({container_name=\"wotb-frontend\",event=\"android_apk_download\"} | logfmt [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "请求趋势",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({container_name=\"wotb-frontend\",event=\"android_apk_download\"} | logfmt [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      }
    }
  ],
  "description": "Last seven days only. No data means no matching received events, not verified zero usage."
}
