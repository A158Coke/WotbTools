{
  "uid": "wotbtools-feature-usage",
  "title": "Feature usage",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "wotbtools",
    "operations"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Active users",
      "type": "link",
      "url": "/d/wotbtools-active-users",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Feature usage",
      "type": "link",
      "url": "/d/wotbtools-feature-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Android downloads",
      "type": "link",
      "url": "/d/wotbtools-android-downloads",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "AI token usage",
      "type": "link",
      "url": "/d/wotbtools-ai-token-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "统计口径",
      "options": {
        "mode": "markdown",
        "content": "回放按文件解析次数，批量 10 个文件算 10 次；重复解析重新计数。其他功能按页面/标签打开计数。Android APK 下载点击由独立 Android downloads 面板统计，不混入功能打开次数。含匿名访问，区分 Web / Android；客户端上报可丢失，不是审计数据。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "解析发起次数",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"replay_parse\" | outcome=\"start\" | keep telemetry_event [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "解析结果",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "成功、失败、取消分别显示；未结算不自动视为失败。",
      "targets": [
        {
          "expr": "sum by (outcome) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"replay_parse\" | outcome != \"start\" | keep outcome [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "功能打开次数",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Android APK 下载点击由 Android downloads 单独统计。",
      "targets": [
        {
          "expr": "sum by (feature, platform) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"feature_open\" | feature != \"android_download\" | keep feature, platform [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "解析失败分类",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum by (error_code, platform) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"replay_parse\" | outcome=\"failure\" | keep error_code, platform [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      }
    }
  ],
  "description": "Last seven days only. No data means no matching received events, not verified zero usage."
}
