{
  "uid": "wotbtools-ai-token-usage",
  "title": "AI token usage",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "wotbtools",
    "operations"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Active users",
      "type": "link",
      "url": "/d/wotbtools-active-users",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Feature usage",
      "type": "link",
      "url": "/d/wotbtools-feature-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Android downloads",
      "type": "link",
      "url": "/d/wotbtools-android-downloads",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "AI token usage",
      "type": "link",
      "url": "/d/wotbtools-ai-token-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "统计口径",
      "options": {
        "mode": "markdown",
        "content": "总消耗按收到上游 usage 的时间统计，包含失败和重试已知消耗；缺失 usage 无法还原账单。平均值按所选窗口内完成的复盘请求汇总，含成功/失败/流内拒绝，不含执行前 HTTP 拒绝；一次复盘内部多次调用合并。跨窗口请求使总量与平均值不能直接相除。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "已知总 token",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_token_usage\" | mode != \"TOURNAMENT_GROUP_RECOGNITION\" | unwrap totalTokens | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "输入 token",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_token_usage\" | mode != \"TOURNAMENT_GROUP_RECOGNITION\" | unwrap inputTokens | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "输出 token",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_token_usage\" | mode != \"TOURNAMENT_GROUP_RECOGNITION\" | unwrap outputTokens | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "平均每次完成复盘 token",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "已知 token 平均值；必须结合缺失 usage 调用数判断完整性。",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_review_usage\" | unwrap totalTokens | __error__=\"\" [$__range])) / sum(count_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_review_usage\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "缺失 usage 调用数",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_token_usage\" | mode != \"TOURNAMENT_GROUP_RECOGNITION\" | unwrap usageMissing | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "完成复盘结果",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum by (result) (count_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_review_usage\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "已知 token 消耗趋势",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum(sum_over_time({container_name=\"ai-service\"} | json message=\"message\" | line_format \"{{.message}}\" | logfmt | event=\"ai_token_usage\" | mode != \"TOURNAMENT_GROUP_RECOGNITION\" | unwrap totalTokens | __error__=\"\" [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      }
    }
  ],
  "description": "Last seven days only. No data means no matching received events, not verified zero usage."
}
