{
  "uid": "wotbtools-active-users",
  "title": "Active users",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "wotbtools",
    "operations"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Active users",
      "type": "link",
      "url": "/d/wotbtools-active-users",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Feature usage",
      "type": "link",
      "url": "/d/wotbtools-feature-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Android downloads",
      "type": "link",
      "url": "/d/wotbtools-android-downloads",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "AI token usage",
      "type": "link",
      "url": "/d/wotbtools-ai-token-usage",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Backend error logs",
      "type": "link",
      "url": "/d/wotbtools-backend-error-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "统计口径",
      "options": {
        "mode": "markdown",
        "content": "已登录且实际前台使用的账号，跨 Web / Android 去重；保持登录也计入。默认最近 24 小时，选择 **Today** 查看北京时间今天。活跃信号最多每 5 分钟一次；旧客户端、离线、上报失败可能低估。无数据不代表零用户。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "所选时间内活跃登录用户",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "targets": [
        {
          "expr": "count(sum by (account_hash) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"active_user\" | account_hash != \"\" | keep account_hash [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
    {
      "title": "滚动 24 小时活跃用户趋势",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "每个点代表此前 24 小时的去重账号；与按日人数相加不同。",
      "targets": [
        {
          "expr": "count(sum by (account_hash) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"active_user\" | account_hash != \"\" | keep account_hash [24h])))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "按平台活跃用户",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "跨平台同一人会分别出现，平台人数不可相加作为去重总人数。",
      "targets": [
        {
          "expr": "count by (platform) (sum by (platform, account_hash) (count_over_time({container_name=\"wotb-backend\"} |= \"event=product_telemetry \" | json message=\"message\" | line_format \"{{.message}}\" | logfmt | telemetry_event=\"active_user\" | account_hash != \"\" | keep account_hash, platform [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      }
    }
  ],
  "description": "Last seven days only. No data means no matching received events, not verified zero usage."
}
