{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[5m]))", "refId": "A" }],
      "title": "HTTP 4xx / 5xx rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (type) (rate(wotb_ai_review_errors_total[5m]))", "legendFormat": "AI {{type}}", "refId": "A" }],
      "title": "AI error classes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "options": { "content": "Use the filters below as regex tokens. `service` maps to the Loki `container_name` label. `errorCode`, `traceId`, `jobId`, and `version` are searched in structured log content; leave them as `.*` to avoid narrowing the search.", "mode": "markdown" },
      "targets": [],
      "title": "Correlation filter guide",
      "type": "text"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 10 },
      "id": 4,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{container_name=~\"${service:raw}\"} | json | level=~\"ERROR|WARN\" |~ \"${errorCode:raw}\" |~ \"${traceId:raw}\" |~ \"${jobId:raw}\" |~ \"${version:raw}\"", "queryType": "range", "refId": "A" }],
      "title": "Filtered error explorer",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["wotbtools", "errors", "correlation"],
  "templating": {
    "list": [
      { "name": "service", "type": "textbox", "label": "service / container", "query": "wotb-backend", "current": { "text": "wotb-backend", "value": "wotb-backend", "selected": true }, "hide": 0, "skipUrlSync": false },
      { "name": "errorCode", "type": "textbox", "label": "errorCode regex", "query": ".*", "current": { "text": ".*", "value": ".*", "selected": true }, "hide": 0, "skipUrlSync": false },
      { "name": "traceId", "type": "textbox", "label": "traceId regex", "query": ".*", "current": { "text": ".*", "value": ".*", "selected": true }, "hide": 0, "skipUrlSync": false },
      { "name": "jobId", "type": "textbox", "label": "jobId regex", "query": ".*", "current": { "text": ".*", "value": ".*", "selected": true }, "hide": 0, "skipUrlSync": false },
      { "name": "version", "type": "textbox", "label": "version regex", "query": ".*", "current": { "text": ".*", "value": ".*", "selected": true }, "hide": 0, "skipUrlSync": false }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "WotBTools Error Explorer",
  "uid": "wotbtools-error-explorer",
  "version": 1
