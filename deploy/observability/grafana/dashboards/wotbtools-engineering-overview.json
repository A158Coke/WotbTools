          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Data status",
      "description": "Age since last successful refresh. No successful initial sync is Not ready. Previous aggregates remain visible after refresh failure.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "floor(time() - wotb_dev_collector_last_success_timestamp) and on() (wotb_dev_collector_data_ready == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Not ready",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 1799,
                "result": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1800,
                "to": 3599,
                "result": {
                  "text": "Delayed",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 3600,
                "to": 1000000000000000.0,
                "result": {
                  "text": "Stale",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "Reading this dashboard",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Activity metric, not productivity score. Area metrics overlap; one PR may belong to multiple areas. Production correlation does not establish causation. Month tables preserve reconstructed historical event buckets. The daily chart plots reconstructed UTC days against the time picker; other trends show observed samples (Prometheus retains seven days)."
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Monthly PR created vs merged",
      "description": "Bucket date is the month label, not scrape time. Backfill starts 2026-06-22. Current bucket is incomplete. Activity metric, not productivity score.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(label_replace(wotb_dev_pr_created_month, \"activity\", \"Created\", \"\", \"\") or label_replace(wotb_dev_pr_merged_month, \"activity\", \"Merged\", \"\", \"\")) and on() (wotb_dev_collector_data_ready == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "service": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "month",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PR Created vs Merged — daily UTC buckets",
      "description": "Activity metric, not productivity score. Latest available snapshot reconstructed from GitHub event dates; each UTC day is plotted at midnight. X-axis follows the Grafana picker. This is not backdated Prometheus sample history. Partial current day; daily history limited to 90 days. A picker end outside observed Prometheus retention can return No data.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(((label_replace(wotb_dev_pr_created_day, \"activity\", \"Created\", \"\", \"\") or label_replace(wotb_dev_pr_merged_day, \"activity\", \"Merged\", \"\", \"\")) and on() (wotb_dev_collector_data_ready == 1)), \"day\", \"${1}T00:00:00Z\", \"day\", \"(.*)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "activity",
            "rowField": "day",
            "valueField": "Value"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "day\\activity",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\activity",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
