    {
      "id": 4,
      "type": "stat",
      "title": "Merge rate",
      "description": "Activity metric, not productivity score. Merge rate excludes open PRs; a zero denominator is undefined.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(wotb_dev_pull_requests{state=\"merged\"}) / sum(wotb_dev_pull_requests{state=~\"merged|closed_unmerged\"})) and on() (wotb_dev_collector_data_ready == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
