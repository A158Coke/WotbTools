      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"wotb-backend\"}[$__rate_interval])) or vector(0)", "instant": true, "refId": "A"}], "title": "当前 HTTP 吞吐", "type": "stat"
