        {"expr": "sum by (result) (rate(wotb_ai_review_results_total[$__rate_interval]))", "legendFormat": "AI {{result}}", "refId": "B"}
      ], "title": "回放与 AI 结果趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
