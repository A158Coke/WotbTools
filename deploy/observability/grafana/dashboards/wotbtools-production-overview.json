        {"expr": "sum(rate(http_server_requests_seconds_count{job=\"wotb-backend\",status=~\"4..\"}[$__rate_interval]))", "legendFormat": "客户端错误 4xx", "refId": "B"},
        {"expr": "sum(rate(http_server_requests_seconds_count{job=\"wotb-backend\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "服务端错误 5xx", "refId": "C"}
