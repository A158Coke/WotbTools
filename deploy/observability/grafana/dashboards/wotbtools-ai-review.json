{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(wotb_ai_review_requests_total[5m]))", "legendFormat": "AI Review requests", "refId": "A" }],
      "title": "AI Review started",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (result) (rate(wotb_ai_review_results_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }],
      "title": "AI Review completed / failed / rejected",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "wotb_ai_review_in_flight", "legendFormat": "in-flight", "refId": "A" }],
      "title": "Active AI Review jobs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(wotb_ai_review_duration_seconds_bucket[5m])) by (le))", "legendFormat": "review P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(wotb_ai_review_duration_seconds_bucket[5m])) by (le))", "legendFormat": "review P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(wotb_ai_review_duration_seconds_bucket[5m])) by (le))", "legendFormat": "review P99", "refId": "C" }
      ],
      "title": "AI Review duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(wotb_ai_upstream_duration_seconds_bucket[5m])) by (le))", "legendFormat": "upstream P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(wotb_ai_review_queue_wait_seconds_bucket[5m])) by (le))", "legendFormat": "queue wait P95", "refId": "B" }
      ],
      "title": "AI upstream / queue P95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (type) (rate(wotb_ai_review_errors_total[5m]))", "legendFormat": "{{type}}", "refId": "A" },
        { "expr": "sum(rate(wotb_ai_team_review_validation_attempt_total{result=\"FAIL\"}[5m]))", "legendFormat": "validation failed / rework", "refId": "B" }
      ],
      "title": "AI errors and validation rework",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "id": 7,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{container_name=\"wotb-backend\"} |= \"ai_review_\"", "queryType": "range", "refId": "A" }],
      "title": "AI Review lifecycle / SSE events",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 8,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{container_name=\"wotb-backend\"} |~ \"ai_validation_retry|ai_review_failed|ai_review_cancelled|ai_upstream_call_failed\"", "queryType": "range", "refId": "A" }],
      "title": "AI failure, cancellation and retry events",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["wotbtools", "ai-review"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "WotBTools AI Review",
  "uid": "wotbtools-ai-review",
  "version": 1
}
