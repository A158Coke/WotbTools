{
  "name": "online",
  "networks": {
    "default": {
      "name": "online_default",
      "ipam": {}
    }
  },
  "services": {
    "alloy": {
      "command": [
        "run",
        "--storage.path=/var/lib/alloy/data",
        "/etc/alloy/config.alloy"
      ],
      "depends_on": {
        "loki": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "grafana/alloy:v1.4.2",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\observability\\alloy\\config.alloy",
          "target": "/etc/alloy/config.alloy",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "grafana": {
      "command": null,
      "depends_on": {
        "loki": {
          "condition": "service_started",
          "required": true
        },
        "prometheus": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "GF_AUTH_ANONYMOUS_ENABLED": "false",
        "GF_SECURITY_ADMIN_PASSWORD": "test-pass-123",
        "GF_SECURITY_ADMIN_USER": "admin",
        "GF_SERVER_ROOT_URL": "https://monitor.wotbtools.com",
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "OBSERVABILITY_ENVIRONMENT": "production"
      },
      "image": "grafana/grafana:11.4.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "mem_limit": "268435456",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\observability\\grafana\\provisioning",
          "target": "/etc/grafana/provisioning",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\observability\\grafana\\dashboards",
          "target": "/var/lib/grafana/dashboards",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "grafana_data",
          "target": "/var/lib/grafana",
          "volume": {}
        }
      ]
    },
    "keycloak": {
      "build": {
        "context": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools",
        "dockerfile": "docker/Dockerfile.keycloak"
      },
      "command": [
        "start",
        "--import-realm",
        "--hostname-strict=false",
        "--http-enabled=true",
        "--http-port=8080"
      ],
      "entrypoint": null,
      "environment": {
        "KC_BOOTSTRAP_ADMIN_PASSWORD": "admin",
        "KC_BOOTSTRAP_ADMIN_USERNAME": "admin",
        "KC_DB": "postgres",
        "KC_DB_PASSWORD": "wotb",
        "KC_DB_URL": "jdbc:postgresql://postgres:5432/keycloak",
        "KC_DB_USERNAME": "wotb"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8080,
          "published": "8080",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\docker\\keycloak\\wotbtools-realm.json",
          "target": "/opt/keycloak/data/import/wotbtools-realm.json",
          "bind": {}
        }
      ]
    },
    "loki": {
      "command": [
        "-config.file=/etc/loki/loki-config.yml"
      ],
      "entrypoint": null,
      "image": "grafana/loki:3.3.2",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "mem_limit": "268435456",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\observability\\loki\\loki-config.yml",
          "target": "/etc/loki/loki-config.yml",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "loki_data",
          "target": "/loki",
          "volume": {}
        }
      ]
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "wotb",
        "POSTGRES_PASSWORD": "wotb",
        "POSTGRES_USER": "wotb"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U wotb -d wotb"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 10
      },
      "image": "postgres:18-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "postgres_data",
          "target": "/var/lib/postgresql",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\init-db.sql",
          "target": "/docker-entrypoint-initdb.d/init-db.sql",
          "bind": {}
        }
      ]
    },
    "prometheus": {
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.retention.time=168h",
        "--storage.tsdb.retention.size=2GB"
      ],
      "depends_on": {
        "wotb-backend": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "prom/prometheus:v2.55.1",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "mem_limit": "402653184",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\observability\\prometheus\\prometheus.yml",
          "target": "/etc/prometheus/prometheus.yml",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "prometheus_data",
          "target": "/prometheus",
          "volume": {}
        }
      ]
    },
    "wotb-backend": {
      "build": {
        "context": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools",
        "dockerfile": "docker/Dockerfile.backend"
      },
      "command": null,
      "depends_on": {
        "keycloak": {
          "condition": "service_started",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AI_API_KEY": "",
        "AI_BASE_URL": "https://api.deepseek.com",
        "AI_CONTEXT_WINDOW_TOKENS": "1000000",
        "AI_MAX_OUTPUT_TOKENS": "32768",
        "AI_MODEL": "deepseek-v4-flash",
        "AI_PROMPT_SAFETY_MARGIN_TOKENS": "16384",
        "AI_REASONING_EFFORT": "high",
        "AI_SINGLE_REPLAY_MAX_INPUT_TOKENS": "940000",
        "AI_THINKING_ENABLED": "true",
        "BOOST_AUTO_CONFIRM_HOURS": "72",
        "BOOST_AUTO_CONFIRM_SCAN_MS": "300000",
        "KEYCLOAK_ADMIN_CLIENT_ID": "wotbtools-admin-api",
        "KEYCLOAK_ADMIN_CLIENT_SECRET": "",
        "KEYCLOAK_ADMIN_REALM": "wotbtools",
        "KEYCLOAK_ADMIN_SERVER_URL": "http://keycloak:8080",
        "KEYCLOAK_ISSUER_URI": "http://keycloak:8080/realms/wotbtools",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_PASSWORD": "wotb",
        "REPLAY_COORDINATE_CLAMP_TOLERANCE": "12.5",
        "REPLAY_COORDINATE_HALF_EXTENT": "250"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "wotb-frontend": {
      "build": {
        "context": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools",
        "dockerfile": "docker/Dockerfile.frontend"
      },
      "command": null,
      "depends_on": {
        "keycloak": {
          "condition": "service_started",
          "required": true
        },
        "wotb-backend": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8088",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\sponsor-config.example.json",
          "target": "/usr/share/nginx/html/sponsor-config.json",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "C:\\Users\\yu.chen\\Desktop\\MyPersonalProject\\WotbTools\\deploy\\sponsor-assets",
          "target": "/usr/share/nginx/html/sponsor-assets",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  },
  "volumes": {
    "grafana_data": {
      "name": "online_grafana_data"
    },
    "loki_data": {
      "name": "online_loki_data"
    },
    "postgres_data": {
      "name": "online_postgres_data"
    },
    "prometheus_data": {
      "name": "online_prometheus_data"
    }
  },
  "x-logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "20m"
    }
  }
}
