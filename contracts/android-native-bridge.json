{
  "schemaVersion": 1,
  "bridgeVersion": 2,
  "origin": "https://appassets.androidplatform.net",
  "allowedOrigins": [
    "https://appassets.androidplatform.net",
    "https://wotbtools.com",
    "https://www.wotbtools.com"
  ],
  "rpc": {
    "request": {
      "id": "string|number",
      "method": "string",
      "params": "object|null"
    },
    "response": {
      "id": "string|number|null",
      "result": "unknown"
    }
  },
  "capabilities": [
    "native-auth",
    "replay-share",
    "replay-open",
    "app-update",
    "connectivity"
  ],
  "methods": {
    "getBridgeVersion": {
      "request": { "fields": {} },
      "response": { "type": "integer" }
    },
    "getCapabilities": {
      "request": { "fields": {} },
      "response": { "type": "string[]" }
    },
    "getPendingReplay": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "pendingId": { "type": "string", "required": true },
          "name": { "type": "string", "required": true },
          "size": { "type": "integer", "required": true },
          "uri": { "type": "string", "required": true }
        }
      }
    },
    "consumePendingReplay": {
      "request": {
        "fields": {
          "expectedPendingId": { "type": "string", "required": true }
        }
      },
      "response": { "type": "boolean" }
    },
    "checkForUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "startUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "fields": {
          "authenticated": { "type": "boolean", "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true }
        }
      }
    },
    "authLogin": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authLogout": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authGetAccessToken": {
      "request": {
        "fields": {
          "minValiditySeconds": { "type": "integer", "required": false }
        }
      },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "token": { "type": "string", "nullable": true, "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true },
          "claims": { "type": "object", "nullable": true, "required": true },
          "error": { "type": "string", "nullable": true, "required": true }
        }
      }
    },
    "connectivityGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "string",
        "enum": ["online", "offline"],
        "notes": "System authority (ConnectivityManager INTERNET + VALIDATED). Reserved future tokens: degraded, service-unavailable. The page must re-read this method after connectivityChanged instead of trusting navigator.onLine."
      }
    }
  },
  "events": {
    "authChanged": {
      "global": "wotbtoolsOnAuthChanged"
    },
    "connectivityChanged": {
      "global": "wotbtoolsOnConnectivityChanged",
      "payload": "none",
      "notes": "Notification only: the page re-reads connectivityGetState, so there is no second source of truth."
    }
  },
  "syntheticResources": {
    "pendingReplay": {
      "method": "GET",
      "url": "https://appassets.androidplatform.net/__native/replay-pending",
      "requiredHeaders": ["X-Wotb-Pending-Id"],
      "failure": "never-fallback-to-network"
    }
  }
}
