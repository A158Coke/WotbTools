{
  "schemaVersion": 1,
  "bridgeVersion": 2,
  "origin": "https://appassets.androidplatform.net",
  "allowedOrigins": [
    "https://appassets.androidplatform.net",
    "https://wotbtools.com",
    "https://www.wotbtools.com"
  ],
  "rpc": {
    "request": {
      "id": "string|number",
      "method": "string",
      "params": "object|null"
    },
    "response": {
      "id": "string|number|null",
      "result": "unknown"
    }
  },
  "capabilities": [
    "native-auth",
    "replay-share",
    "replay-open",
    "app-update",
    "connectivity",
    "replay-folder-picker"
  ],
  "methods": {
    "getBridgeVersion": {
      "request": { "fields": {} },
      "response": { "type": "integer" }
    },
    "getCapabilities": {
      "request": { "fields": {} },
      "response": { "type": "string[]" }
    },
    "getPendingReplay": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "pendingId": { "type": "string", "required": true },
          "name": { "type": "string", "required": true },
          "size": { "type": "integer", "required": true },
          "uri": { "type": "string", "required": true }
        }
      }
    },
    "consumePendingReplay": {
      "request": {
        "fields": {
          "expectedPendingId": { "type": "string", "required": true }
        }
      },
      "response": { "type": "boolean" }
    },
    "checkForUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "startUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "fields": {
          "authenticated": { "type": "boolean", "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true }
        }
      }
    },
    "authLogin": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authLogout": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authGetAccessToken": {
      "request": {
        "fields": {
          "minValiditySeconds": { "type": "integer", "required": false }
        }
      },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "token": { "type": "string", "nullable": true, "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true },
          "claims": { "type": "object", "nullable": true, "required": true, "notes": "On refresh-failed a retained Native session may project cached claims for local UI; token remains null and API authorization requires a fresh token." },
          "error": { "type": "string", "nullable": true, "required": true }
        }
      }
    },
    "connectivityGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "string",
        "enum": ["online", "offline"],
        "notes": "System authority (ConnectivityManager INTERNET + VALIDATED). Reserved future tokens: degraded, service-unavailable. The page must re-read this method after connectivityChanged instead of trusting navigator.onLine."
      }
    },
    "pickReplayFolder": {
      "request": {
        "fields": {
          "requestId": { "type": "string", "required": true }
        }
      },
      "response": {
        "type": "object",
        "fields": {
          "status": {
            "type": "string",
            "enum": [
              "selected",
              "cancelled",
              "failed"
            ],
            "required": true
          },
          "selectionId": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "files": {
            "type": "object[]",
            "required": true,
            "fields": {
              "fileId": {
                "type": "string",
                "required": true
              },
              "name": {
                "type": "string",
                "required": true
              },
              "relativePath": {
                "type": "string",
                "required": true
              },
              "size": {
                "type": "integer",
                "nullable": true,
                "required": true
              },
              "lastModified": {
                "type": "integer",
                "required": true
              }
            }
          }
        },
        "notes": "Optional replay-folder-picker capability. User chooses a directory with ACTION_OPEN_DOCUMENT_TREE. Native enumerates descendants off the UI thread with an infrastructure scan bound, retaining only transient document references. No persisted directory permission, automatic analysis or external pending replay mutation. Cancel/failure use null selectionId and empty files. Frontend filters and validates with the existing replay selection rules before reading."
      }
    },
    "cancelReplayFolderPicker": {
      "request": {
        "fields": { "requestId": { "type": "string", "required": true } }
      },
      "response": {
        "type": "boolean",
        "notes": "Cancel only the in-flight picker/scan belonging to this client requestId. An old caller must never cancel a newer request. Does not release an already completed selection."
      }
    },
    "releaseReplayFolderSelection": {
      "request": {
        "fields": {
          "selectionId": {
            "type": "string",
            "required": true
          }
        }
      },
      "response": {
        "type": "boolean",
        "notes": "Compare-and-clear only this transient selection; a stale release must not clear a newer selection."
      }
    }
  },
  "events": {
    "authChanged": {
      "global": "wotbtoolsOnAuthChanged"
    },
    "connectivityChanged": {
      "global": "wotbtoolsOnConnectivityChanged",
      "payload": "none",
      "notes": "Notification only: the page re-reads connectivityGetState, so there is no second source of truth."
    }
  },
  "syntheticResources": {
    "pendingReplay": {
      "method": "GET",
      "url": "https://appassets.androidplatform.net/__native/replay-pending",
      "requiredHeaders": ["X-Wotb-Pending-Id"],
      "failure": "never-fallback-to-network"
    },
    "folderReplay": {
      "method": "GET",
      "url": "https://appassets.androidplatform.net/__native/replay-folder",
      "requiredHeaders": [
        "X-Wotb-Folder-Selection-Id",
        "X-Wotb-Folder-File-Id"
      ],
      "failure": "never-fallback-to-network",
      "notes": "Native resolves only a file belonging to the exact current transient folder selection. No content URI or arbitrary path accepted from Web; Cache-Control: no-store."
    }
  }
}
