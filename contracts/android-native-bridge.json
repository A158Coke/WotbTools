{
  "schemaVersion": 1,
  "bridgeVersion": 3,
  "origin": "http://127.0.0.1:21653",
  "allowedOrigins": [
    "http://127.0.0.1:21653"
  ],
  "transport": "GeckoView built-in WebExtension (android/app/src/main/assets/gecko-bridge) exposes window.WotbNative with postMessage(string) / addEventListener('message') / removeEventListener to the exact origin's top frame only. The content-script injection scope is the coarse host pattern `http://127.0.0.1/*` because Gecko WebExtension match patterns cannot express a port (MDN match patterns / Firefox bug 1362809); the exact origin is enforced by the content-script gate (protocol + hostname + port + top frame) and re-validated by Native, which accepts only the sender (content script, top frame, current session, exact origin).",
  "rpc": {
    "request": {
      "id": "string|number",
      "method": "string",
      "params": "object|null"
    },
    "response": {
      "id": "string|number|null",
      "result": "unknown"
    }
  },
  "capabilities": [
    "native-auth",
    "replay-share",
    "replay-open",
    "app-update",
    "app-update-status",
    "connectivity",
    "replay-folder-picker",
    "screen-form",
    "haptics"
  ],
  "methods": {
    "getBridgeVersion": {
      "request": { "fields": {} },
      "response": { "type": "integer" }
    },
    "getCapabilities": {
      "request": { "fields": {} },
      "response": { "type": "string[]" }
    },
    "getPendingReplay": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "pendingId": { "type": "string", "required": true },
          "name": { "type": "string", "required": true },
          "size": { "type": "integer", "required": true },
          "uri": { "type": "string", "required": true }
        }
      }
    },
    "consumePendingReplay": {
      "request": {
        "fields": {
          "expectedPendingId": { "type": "string", "required": true }
        }
      },
      "response": { "type": "boolean" }
    },
    "checkForUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "startUpdate": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "getUpdateStatus": {
      "request": {
        "fields": {}
      },
      "response": {
        "type": "object",
        "fields": {
          "revision": {
            "type": "integer",
            "required": true,
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "required": true,
            "enum": [
              "unknown",
              "checking",
              "upToDate",
              "optional",
              "mandatory",
              "checkFailed"
            ]
          },
          "checkState": {
            "type": "string",
            "required": true,
            "enum": [
              "idle",
              "checking",
              "succeeded",
              "failed"
            ]
          },
          "checkFailureReason": {
            "type": "string",
            "nullable": true,
            "required": true,
            "enum": [
              "offline",
              "network",
              "invalidManifest"
            ]
          },
          "currentVersionName": {
            "type": "string",
            "required": true
          },
          "currentVersionCode": {
            "type": "integer",
            "required": true,
            "minimum": 0
          },
          "latestVersionName": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "latestVersionCode": {
            "type": "integer",
            "nullable": true,
            "required": true,
            "minimum": 0
          },
          "minSupportedVersionCode": {
            "type": "integer",
            "nullable": true,
            "required": true,
            "minimum": 0
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "releaseNotes": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "optionalPromptSuppressed": {
            "type": "boolean",
            "required": true
          },
          "download": {
            "type": "object",
            "required": true,
            "fields": {
              "taskToken": {
                "type": "string",
                "nullable": true,
                "required": true
              },
              "versionName": {
                "type": "string",
                "nullable": true,
                "required": true
              },
              "versionCode": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0
              },
              "packageType": {
                "type": "string",
                "nullable": true,
                "required": false,
                "enum": ["full", "delta"]
              },
              "state": {
                "type": "string",
                "required": true,
                "enum": [
                  "idle",
                  "queued",
                  "downloading",
                  "selectingPackage",
                  "downloadingDelta",
                  "verifyingDelta",
                  "applyingDelta",
                  "verifyingTargetApk",
                  "fallbackFull",
                  "paused",
                  "verifying",
                  "ready",
                  "installRequested",
                  "downloadFailed",
                  "verifyFailed",
                  "installPermissionRequired",
                  "installRequestFailed"
                ]
              },
              "downloadedBytes": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalBytes": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "progressPercent": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0,
                "maximum": 100
              },
              "failureReason": {
                "type": "string",
                "nullable": true,
                "required": true,
                "enum": [
                  "waitingNetwork",
                  "waitingRetry",
                  "waitingWifi",
                  "pausedUnknown",
                  "network",
                  "http",
                  "cannotResume",
                  "insufficientStorage",
                  "storageUnavailable",
                  "fileIo",
                  "taskMissing",
                  "hashMismatch",
                  "baseHashMismatch",
                  "patchDownloadFailed",
                  "patchHashMismatch",
                  "patchApplyFailed",
                  "targetHashMismatch",
                  "artifactMissing",
                  "unsupportedArtifact",
                  "permissionDenied",
                  "installerUnavailable",
                  "unknown"
                ]
              }
            }
          }
        }
      },
      "notes": "只读取 Native-owned snapshot，不触发网络；可空字段始终显式返回 null。"
    },
    "refreshUpdateStatus": {
      "request": {
        "fields": {}
      },
      "response": {
        "type": "object",
        "fields": {
          "revision": {
            "type": "integer",
            "required": true,
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "required": true,
            "enum": [
              "unknown",
              "checking",
              "upToDate",
              "optional",
              "mandatory",
              "checkFailed"
            ]
          },
          "checkState": {
            "type": "string",
            "required": true,
            "enum": [
              "idle",
              "checking",
              "succeeded",
              "failed"
            ]
          },
          "checkFailureReason": {
            "type": "string",
            "nullable": true,
            "required": true,
            "enum": [
              "offline",
              "network",
              "invalidManifest"
            ]
          },
          "currentVersionName": {
            "type": "string",
            "required": true
          },
          "currentVersionCode": {
            "type": "integer",
            "required": true,
            "minimum": 0
          },
          "latestVersionName": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "latestVersionCode": {
            "type": "integer",
            "nullable": true,
            "required": true,
            "minimum": 0
          },
          "minSupportedVersionCode": {
            "type": "integer",
            "nullable": true,
            "required": true,
            "minimum": 0
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "releaseNotes": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "optionalPromptSuppressed": {
            "type": "boolean",
            "required": true
          },
          "download": {
            "type": "object",
            "required": true,
            "fields": {
              "taskToken": {
                "type": "string",
                "nullable": true,
                "required": true
              },
              "versionName": {
                "type": "string",
                "nullable": true,
                "required": true
              },
              "versionCode": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0
              },
              "packageType": {
                "type": "string",
                "nullable": true,
                "required": false,
                "enum": ["full", "delta"]
              },
              "state": {
                "type": "string",
                "required": true,
                "enum": [
                  "idle",
                  "queued",
                  "downloading",
                  "selectingPackage",
                  "downloadingDelta",
                  "verifyingDelta",
                  "applyingDelta",
                  "verifyingTargetApk",
                  "fallbackFull",
                  "paused",
                  "verifying",
                  "ready",
                  "installRequested",
                  "downloadFailed",
                  "verifyFailed",
                  "installPermissionRequired",
                  "installRequestFailed"
                ]
              },
              "downloadedBytes": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalBytes": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "progressPercent": {
                "type": "integer",
                "nullable": true,
                "required": true,
                "minimum": 0,
                "maximum": 100
              },
              "failureReason": {
                "type": "string",
                "nullable": true,
                "required": true,
                "enum": [
                  "waitingNetwork",
                  "waitingRetry",
                  "waitingWifi",
                  "pausedUnknown",
                  "network",
                  "http",
                  "cannotResume",
                  "insufficientStorage",
                  "storageUnavailable",
                  "fileIo",
                  "taskMissing",
                  "hashMismatch",
                  "baseHashMismatch",
                  "patchDownloadFailed",
                  "patchHashMismatch",
                  "patchApplyFailed",
                  "targetHashMismatch",
                  "artifactMissing",
                  "unsupportedArtifact",
                  "permissionDenied",
                  "installerUnavailable",
                  "unknown"
                ]
              }
            }
          }
        }
      },
      "notes": "显式刷新，异步返回本次检查的 terminal snapshot；并发检查合并。已有分类在检查中或失败时保留，checkState 表示本次结果。客户端 RPC 预算 15000ms。"
    },
    "beginUpdateDownload": {
      "request": {
        "fields": {
          "expectedLatestVersionCode": {
            "type": "integer",
            "required": true,
            "minimum": 0
          }
        }
      },
      "response": {
        "type": "boolean"
      },
      "notes": "Compare-and-act：仅为当前最新版本启动用户主动下载；true 表示动作被接受，不代表下载完成。不接受 URL、路径或 SHA。"
    },
    "installUpdate": {
      "request": {
        "fields": {
          "expectedTaskToken": {
            "type": "string",
            "required": true
          }
        }
      },
      "response": {
        "type": "boolean"
      },
      "notes": "Compare-and-act：仅对同一任务的已验证 APK 请求安装。true 表示动作被接受，不代表安装成功；缺权限或失败状态回读 snapshot。"
    },
    "dismissOptionalUpdate": {
      "request": {
        "fields": {
          "expectedLatestVersionCode": {
            "type": "integer",
            "required": true,
            "minimum": 0
          }
        }
      },
      "response": {
        "type": "boolean"
      },
      "notes": "仅抑制同一 optional 版本的主动提示；不影响手动检查，mandatory 永远忽略抑制。"
    },
    "authGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "fields": {
          "authenticated": { "type": "boolean", "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true }
        }
      }
    },
    "authLogin": {
      "request": {
        "fields": {
          "locale": { "type": "string", "enum": ["zh", "en", "ru"], "required": false, "notes": "站点当前语言，Native 作为 OIDC ui_locales 传给 Keycloak 登录页；缺省或不在白名单内时不带 ui_locales（旧 Native 忽略该字段）。" }
        }
      },
      "response": { "type": "boolean" }
    },
    "authLogout": {
      "request": { "fields": {} },
      "response": { "type": "boolean" }
    },
    "authGetAccessToken": {
      "request": {
        "fields": {
          "minValiditySeconds": { "type": "integer", "required": false }
        }
      },
      "response": {
        "type": "object",
        "nullable": true,
        "fields": {
          "token": { "type": "string", "nullable": true, "required": true },
          "expiresAt": { "type": "integer", "nullable": true, "required": true },
          "claims": { "type": "object", "nullable": true, "required": true, "notes": "On refresh-failed a retained Native session may project cached claims for local UI; token remains null and API authorization requires a fresh token." },
          "error": { "type": "string", "nullable": true, "required": true }
        }
      }
    },
    "connectivityGetState": {
      "request": { "fields": {} },
      "response": {
        "type": "string",
        "enum": ["online", "offline"],
        "notes": "System authority (ConnectivityManager INTERNET + VALIDATED). Reserved future tokens: degraded, service-unavailable. The page must re-read this method after connectivityChanged instead of trusting navigator.onLine."
      }
    },
    "pickReplayFolder": {
      "request": {
        "fields": {
          "requestId": { "type": "string", "required": true }
        }
      },
      "response": {
        "type": "object",
        "fields": {
          "status": {
            "type": "string",
            "enum": [
              "selected",
              "cancelled",
              "failed"
            ],
            "required": true
          },
          "selectionId": {
            "type": "string",
            "nullable": true,
            "required": true
          },
          "files": {
            "type": "object[]",
            "required": true,
            "fields": {
              "fileId": {
                "type": "string",
                "required": true
              },
              "name": {
                "type": "string",
                "required": true
              },
              "relativePath": {
                "type": "string",
                "required": true
              },
              "size": {
                "type": "integer",
                "nullable": true,
                "required": true
              },
              "lastModified": {
                "type": "integer",
                "required": true
              }
            }
          }
        },
        "notes": "Optional replay-folder-picker capability. User chooses a directory with ACTION_OPEN_DOCUMENT_TREE. Native enumerates descendants off the UI thread with an infrastructure scan bound, retaining only transient document references. No persisted directory permission, automatic analysis or external pending replay mutation. Cancel/failure use null selectionId and empty files. Frontend filters and validates with the existing replay selection rules before reading."
      }
    },
    "cancelReplayFolderPicker": {
      "request": {
        "fields": { "requestId": { "type": "string", "required": true } }
      },
      "response": {
        "type": "boolean",
        "notes": "Cancel only the in-flight picker/scan belonging to this client requestId. An old caller must never cancel a newer request. Does not release an already completed selection."
      }
    },
    "getScreenForm": {
      "request": { "fields": {} },
      "response": {
        "type": "object",
        "fields": {
          "phone": { "type": "boolean", "required": true }
        },
        "notes": "Optional screen-form capability. phone = Configuration.smallestScreenWidthDp < 600; tablets report false. The page uses it only to decide whether scene pages (2D / 3D playback, armor viewer, shot replay, map 3D) force landscape."
      }
    },
    "setOrientationLock": {
      "request": {
        "fields": {
          "orientation": { "type": "string", "required": true, "enum": ["landscape", "portrait", "unspecified"] }
        }
      },
      "response": {
        "type": "boolean",
        "notes": "Phones only: landscape requests SENSOR_LANDSCAPE (scene pages), portrait requests PORTRAIT (replay workspace viewers while not fullscreen), unspecified releases the page lock. Returns false (no-op) on tablets or an unknown value. HTML fullscreen forces landscape itself and restores to the page lock state on exit."
      }
    },
    "haptic": {
      "request": {
        "fields": {
          "kind": { "type": "string", "required": true, "enum": ["selection", "primary", "success", "error", "endpoint"] }
        }
      },
      "response": {
        "type": "boolean",
        "notes": "Optional haptics capability. Native maps the kind to a system HapticFeedbackConstants value on the content view (respects the system touch-feedback setting). Unknown kinds return false. The page owns the user preference (default on) and never calls this when it is off."
      }
    },
    "releaseReplayFolderSelection": {
      "request": {
        "fields": {
          "selectionId": {
            "type": "string",
            "required": true
          }
        }
      },
      "response": {
        "type": "boolean",
        "notes": "Compare-and-clear only this transient selection; a stale release must not clear a newer selection."
      }
    }
  },
  "events": {
    "authChanged": {
      "global": "wotbtoolsOnAuthChanged"
    },
    "connectivityChanged": {
      "global": "wotbtoolsOnConnectivityChanged",
      "payload": "none",
      "notes": "Notification only: the page re-reads connectivityGetState, so there is no second source of truth."
    },
    "updateStatusChanged": {
      "global": "wotbtoolsOnUpdateStatusChanged",
      "payload": "none",
      "notes": "仅通知状态变化；页面订阅后首读 getUpdateStatus，事件后重新回读，revision 拒绝迟到快照。"
    },
    "replay": {
      "global": "wotbtoolsOnReplay",
      "payload": "none",
      "notes": "Sent only while the replay workspace is already loaded; the page reads getPendingReplay and ACKs with consumePendingReplay."
    }
  },
  "syntheticResources": {
    "pendingReplay": {
      "method": "GET",
      "url": "http://127.0.0.1:21653/__native/replay-pending",
      "requiredHeaders": ["X-Wotb-Pending-Id"],
      "failure": "never-fallback-to-network"
    },
    "folderReplay": {
      "method": "GET",
      "url": "http://127.0.0.1:21653/__native/replay-folder",
      "requiredHeaders": [
        "X-Wotb-Folder-Selection-Id",
        "X-Wotb-Folder-File-Id"
      ],
      "failure": "never-fallback-to-network",
      "notes": "Native resolves only a file belonging to the exact current transient folder selection. No content URI or arbitrary path accepted from Web; Cache-Control: no-store."
    }
  }
}
