<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wotb</groupId>
        <artifactId>wotb-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wotb-web</artifactId>
    <name>WotBTools Web</name>

    <properties>
        <!-- 默认排除人工探测类（占点时间线等）；运行探测时用 -Dai.probe.excludedGroups= 覆盖 -->
        <ai.probe.excludedGroups>ai-capture-probe,ai-live</ai.probe.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-result</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-playback</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-replay-coordinator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-replay-processing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-contracts</artifactId>
        </dependency>
        <!-- 回放控制面：对象存储键布局 + AMQP 投递/消费适配器。两个模块都刻意不带任何
             stereotype，装配只发生在 com.wotb.web.replay.config.ReplayDistributedConfig。 -->
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-object-storage-minio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wotb</groupId>
            <artifactId>wotb-broker-rabbitmq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 可观测性: Actuator + Prometheus 指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Boot 4 把 Flyway 自动配置拆到独立模块; 仅 flyway-core 不会在启动时自动迁移。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Security matcher and Keycloak realm-role regression tests. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <!-- 架构测试（随 mvn test 执行）：domain 分包 + 分层 + 无循环依赖 -->
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Admin Client 独立使用 26.0.x 发布线；representation model 跟随后端 Keycloak Core。 -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>26.0.9</version>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>26.6.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>wotb-web</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../frontend/dist</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <excludedGroups>${ai.probe.excludedGroups}</excludedGroups>
                    <!-- 生产总是装配分布式回放控制面（ReplayDistributedConfig 不再有条件门控），
                         因此全上下文 @SpringBootTest 必须像生产一样提供控制面配置，否则 fail-closed
                         的 MinioObjectStorageProperties/RabbitBrokerProperties 会让 context 启动失败。
                         取值只用于启动装配；测试不连接真实 MinIO/RabbitMQ。 -->
                    <systemPropertyVariables>
                        <wotb.replay.object-storage.access-key>test-access-key</wotb.replay.object-storage.access-key>
                        <wotb.replay.processing-job.repository>jdbc</wotb.replay.processing-job.repository>
                        <wotb.replay.object-storage.secret-key>test-secret-key</wotb.replay.object-storage.secret-key>
                        <wotb.replay.broker.host>localhost</wotb.replay.broker.host>
                        <wotb.replay.broker.username>test-control-api</wotb.replay.broker.username>
                        <wotb.replay.broker.password>test-control-api</wotb.replay.broker.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${springboot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
